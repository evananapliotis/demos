---
/**
 * Document shell for the front page of mybarbersite.co.uk. Indexable, with a
 * link-preview image from /og.jpg, the shop pages' faces and palette, the
 * scroll progress line and the reveal observer.
 */
import '../styles/home.css';
import serifWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import bodyWoff2 from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
// The phone's still is set in the shop's display face, above the fold.
import displayWoff2 from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import { OWNER } from '../lib/home.ts';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageUrl = new URL('/', Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MyBarberSite',
  url: pageUrl,
  telephone: OWNER.phone.tel,
  description,
  image: ogImage,
  areaServed: 'GB',
};
---

<!doctype html>
<html lang="en-GB" class="bg-paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#f1eee7" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={serifWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={serifItalicWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={displayWoff2} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MyBarberSite" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MyBarberSite: get seen, get booked. Your shop online, built first. £500 one-off, no monthly fee, live in 48 hours." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="bg-paper text-print antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-ox focus:px-4 focus:py-3 focus:font-bold focus:text-paper"
      >Skip to content</a
    >
    <div class="progress" data-progress aria-hidden="true"></div>
    <slot />
    <script>
      // A light tap on Android when a big button is pressed.
      document.addEventListener('click', (e) => { if ((e.target as Element | null)?.closest?.('.btn, .cta')) { try { navigator.vibrate?.(6); } catch { /* unsupported */ } } }, { passive: true });
      const bar = document.querySelector<HTMLElement>('[data-progress]');
      if (bar && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let raf = 0;
        const paint = () => {
          raf = 0;
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        };
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
        paint();
      }
      // Sections settle into place as they arrive. Quick, and only once.
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
