---
/**
 * Document shell for a /[slug] page. Every page is a demo built from a
 * public listing, so it is noindex and says so in the footer.
 */
import '../styles/demo.css';
import displayWoff2 from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import { CLIENT_SLUG } from '../config/build.ts';
import { jsonLd, type DemoSite } from '../lib/demo.ts';

interface Props {
  site: DemoSite;
  title: string;
  description: string;
  /** The shop page preloads its hero photo; inner pages do not. */
  preloadHero?: boolean;
}
const { site, title, description, preloadHero = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '');
/** Rendered by src/pages/[slug]/og.jpg.ts; the booking page shares the shop page's. A single-client build has no slug path, so its one image is /og.jpg. */
const ogImage = new URL(CLIENT_SLUG ? '/og.jpg' : `/${site.slug}/og.jpg`, Astro.site).href;
const ld = jsonLd(site, pageUrl, ogImage);
const ratingAlt = site.google.rating != null ? `Rated ${site.google.rating.toFixed(1)} from ${site.google.reviewsText}.` : `${site.google.reviewsText}.`;
---

<!doctype html>
<html lang="en-GB" class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0e0c0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preload" as="font" type="font/woff2" href={displayWoff2} crossorigin />
    {preloadHero && site.hero && <link rel="preload" as="image" href={site.hero.path} fetchpriority="high" />}

    <meta property="og:type" content="business.business" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.fullAddress}. ${ratingAlt}`} />
    <meta property="business:contact_data:street_address" content={site.address.street} />
    <meta property="business:contact_data:locality" content={site.address.locality} />
    <meta property="business:contact_data:postal_code" content={site.address.postcode} />
    <meta property="business:contact_data:country_name" content="United Kingdom" />
    <meta property="business:contact_data:phone_number" content={site.phone.tel} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.placename" content={site.fullAddress} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="bg-ink text-cream antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-amber focus:px-4 focus:py-3 focus:font-bold focus:text-ink"
      >Skip to content</a
    >
    <div class="progress" data-progress aria-hidden="true"></div>
    <slot />
    <script>
      // A light tap on Android when a big button is pressed.
      document.addEventListener('click', (e) => { if ((e.target as Element | null)?.closest?.('.btn')) { try { navigator.vibrate?.(6); } catch { /* unsupported */ } } }, { passive: true });
      const bar = document.querySelector<HTMLElement>('[data-progress]');
      if (bar && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let raf = 0;
        const paint = () => {
          raf = 0;
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        };
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
        paint();
      }
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
