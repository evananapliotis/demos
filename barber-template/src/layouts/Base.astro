---
import '../styles/global.css';
import { site } from '../config/site.ts';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import type { Preload } from '../lib/img.ts';

interface Props {
  title: string;
  description?: string;
  preload?: Preload[];
}

const { title, description, preload = [] } = Astro.props;
const lang = site.seo.locale.replace('_', '-');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" href="/fonts/bebas-neue-latin.woff2" type="font/woff2" crossorigin />
    {preload.map((p) => <link rel="preload" as="image" fetchpriority="high" imagesrcset={p.imagesrcset} imagesizes={p.imagesizes} media={p.media} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{site.ui.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
  </body>
</html>
