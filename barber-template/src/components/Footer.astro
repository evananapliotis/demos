---
import { site } from '../config/site.ts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__in">
    <p class="sample-label">{site.footer.sampleLabel}</p>
    <div class="site-footer__row">
      <p class="muted">&copy; {year} {site.footer.copyrightHolder}</p>
      <ul class="site-footer__links">
        <li><a href="/credits">{site.footer.creditsLinkLabel}</a></li>
        <li><a href="https://www.pexels.com" rel="noopener">{site.footer.pexelsLinkLabel}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-5);
    font-size: var(--step--1);
  }
  .site-footer__in {
    display: grid;
    gap: var(--space-3);
  }
  .sample-label {
    display: inline-block;
    max-width: none;
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--accent);
    border-radius: var(--radius);
    color: var(--accent);
    letter-spacing: 0.04em;
    justify-self: start;
  }
  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .site-footer__links {
    display: flex;
    gap: var(--space-4);
  }
</style>
