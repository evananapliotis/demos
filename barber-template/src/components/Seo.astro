---
import { site } from '../config/site.ts';
import { derivedFile, getSlot } from '../config/images.ts';
import { versioned } from '../lib/img.ts';
import { DAYS } from '../config/site.schema.ts';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.seo.description } = Astro.props;
const fullTitle = title === site.seo.defaultTitle ? title : site.seo.titleTemplate.replace('%s', title);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogSlot = getSlot(site.seo.ogImage);
const ogImage = new URL(versioned(ogSlot.kind === 'derived' ? derivedFile(ogSlot) : ''), Astro.site);

const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BarberShop',
  name: site.business.name,
  description: site.seo.description,
  url: site.seo.siteUrl,
  image: ogImage.href,
  telephone: site.contact.phoneHref,
  email: site.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: [site.contact.address.line1, site.contact.address.line2].filter(Boolean).join(', '),
    addressLocality: site.contact.address.city,
    postalCode: site.contact.address.postcode,
    addressCountry: 'GB',
  },
  openingHoursSpecification: DAYS.flatMap((day) => {
    const h = site.hours.schedule[day];
    return h === 'closed' ? [] : [{ '@type': 'OpeningHoursSpecification', dayOfWeek: capitalise(day), opens: h.open, closes: h.close }];
  }),
  priceRange: '££',
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta name="theme-color" content={site.seo.themeColour} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.business.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content={String(ogSlot.kind === 'derived' ? ogSlot.width : 1200)} />
<meta property="og:image:height" content={String(ogSlot.kind === 'derived' ? ogSlot.height : 630)} />
<meta property="og:locale" content={site.seo.locale} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
