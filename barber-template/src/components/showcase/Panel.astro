---
/* The showcase shop's first screen, condensed for the before/after panel. */
import { SHOP } from '../../lib/showcase.ts';
import Icons from '../demo/Icons.astro';
import Rating from './Rating.astro';
import Photo from './Photo.astro';
const [first, second] = SHOP.nameLines;
---
<div class="flex flex-1 flex-col p-4">
  <div class="flex items-center justify-between gap-3">
    <span class="sc-tag">{SHOP.kind} · {SHOP.town}</span>
    <span class="sc-pill sc-pill-moss min-h-9 px-3.5 text-sm">Book</span>
  </div>
  <p class="sc-display mt-4 text-[2.6rem]">{first} <span class="text-moss">{second}</span></p>
  <div class="relative mt-4 aspect-[16/10] overflow-hidden rounded-[1.25rem] bg-sand">
    <Photo index={0} class="absolute inset-0 h-full w-full object-cover" />
    <Rating class="absolute bottom-3 left-3" />
  </div>
  <p class="mt-4 flex items-center gap-2 text-sm font-semibold text-cocoa"><span class="sc-dot" data-status-dot></span><span data-open-status>{SHOP.openLabel}</span></p>
  <div class="mt-3 grid grid-cols-2 gap-2">
    <span class="sc-pill sc-pill-line min-h-11 text-sm"><Icons name="phone" size={16} /> Call</span>
    <span class="sc-pill sc-pill-line min-h-11 text-sm"><Icons name="pin" size={16} /> Directions</span>
  </div>
  <span class="sc-pill sc-pill-moss mt-2 min-h-11 text-sm"><Icons name="calendar" size={16} /> Book online</span>
  <div class="mt-auto grid grid-cols-3 gap-2 pt-4">
    {[0, 1, 2].map((i) => <div class="aspect-square overflow-hidden rounded-xl bg-sand"><Photo index={i} class="h-full w-full object-cover" /></div>)}
  </div>
</div>
