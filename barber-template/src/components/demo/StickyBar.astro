---
import type { DemoSite } from '../../lib/demo.ts';
import Icons from './Icons.astro';
interface Props { site: DemoSite; book?: boolean }
const { site, book = true } = Astro.props;
---
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-ink/92 pb-[max(0.625rem,env(safe-area-inset-bottom))] pt-2.5 backdrop-blur"
  role="region"
  aria-label={book ? 'Book, call or get directions' : 'Call or get directions'}
>
  <div class={`mx-auto grid max-w-md gap-2 px-3 ${book ? 'grid-cols-[1.15fr_1fr_1fr]' : 'grid-cols-2 gap-2.5 px-4'}`}>
    {book && (
      <a href={site.bookHref} class="btn btn-amber min-h-12 px-2 text-[0.95rem]" aria-label="Book online">
        <Icons name="calendar" size={18} class="hidden min-[360px]:block" /> Book<span class="hidden min-[480px]:inline">&nbsp;online</span>
      </a>
    )}
    <a href={site.telHref} class={`btn ${book ? 'btn-outline px-2 text-[0.95rem]' : 'btn-amber text-base'} min-h-12`} aria-label={`Call ${site.phone.display}`}><Icons name="phone" size={18} /> Call</a>
    <a href={site.directionsUrl} target="_blank" rel="noopener" class={`btn btn-outline min-h-12 ${book ? 'px-2 text-[0.95rem]' : 'text-base'}`} aria-label="Directions">
      <Icons name="pin" size={18} class={book ? 'hidden min-[360px]:block' : ''} />
      {book ? <><span class="min-[400px]:hidden">Map</span><span class="hidden min-[400px]:inline">Directions</span></> : 'Directions'}
    </a>
  </div>
</div>
