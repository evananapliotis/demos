---
/* Google reviews: the rating band, the per-star bar when the export carries reviews_per_score, and the link to read them on Google. */
import type { DemoSite } from '../../lib/demo.ts';
import Stars from './Stars.astro';
import GoogleG from './GoogleG.astro';
import Icons from './Icons.astro';
interface Props {
  site: DemoSite;
  /** Sit on the raised ground, so two neighbouring sections never share a tone. */
  alt?: boolean;
}
const { site, alt = false } = Astro.props;
const nf = new Intl.NumberFormat('en-GB');
const { rating, reviewCount } = site.google;
---
<section id="reviews" class={`scroll-mt-14 border-y border-line px-5 py-16 sm:px-8 md:py-24 lg:px-12 ${alt ? 'bg-ink-2' : 'bg-ink'}`} aria-labelledby="reviews-title">
  <div class="mx-auto max-w-5xl" data-reveal>
    <p class="eyebrow flex items-center gap-3 before:block before:h-[2px] before:w-6 before:bg-amber">{site.copy.reviewsEyebrow}</p>
    <div class="mt-6 grid items-end gap-6 md:grid-cols-[auto_1fr] md:gap-14">
      <div class="flex items-end gap-4">
        <p class="display text-[7.5rem] leading-[0.8] text-cream md:text-[12rem]">{rating != null ? rating.toFixed(1) : '–'}</p>
        <div class="pb-2">
          <Stars rating={rating ?? 0} class="stars-in text-amber" size={24} />
          <p class="mt-2 text-sm text-cream-2">{rating != null ? 'out of 5' : 'not yet rated'}</p>
        </div>
      </div>
      <div class="md:pb-4">
        <h2 id="reviews-title" class="text-[clamp(2.5rem,10vw,5rem)] text-cream">
          <span class="tabular-nums" data-count={reviewCount}>{nf.format(reviewCount)}</span> {reviewCount === 1 ? 'review' : 'reviews'}.<br /><span class="accent">{site.copy.reviewsAccent}</span>
        </h2>
        <p class="mt-4 max-w-md text-cream-2">{site.copy.reviewsLede}</p>
        {
          site.scoreBars && (
            <ul class="mt-6 max-w-md space-y-1.5" role="list" aria-label="Reviews by star rating">
              {site.scoreBars.map((b) => (
                <li class="grid grid-cols-[2.6rem_1fr_3.2rem] items-center gap-3 text-sm">
                  <span class="inline-flex items-center gap-1 font-bold text-cream" aria-label={`${b.score} star`}>{b.score}<Icons name="star" size={13} class="text-amber" /></span>
                  <span class="h-2 overflow-hidden rounded-full bg-cream/10"><span class="score-bar block h-full rounded-full bg-amber" style={`--w:${Math.round(b.share * 100)}%`}></span></span>
                  <span class="text-right tabular-nums text-cream-2">{nf.format(b.count)}</span>
                </li>
              ))}
            </ul>
          )
        }
        <a href={site.reviewsUrl} target="_blank" rel="noopener" class="btn btn-amber mt-6"><GoogleG size={18} /> Open the Google reviews <Icons name="external" size={16} /></a>
      </div>
    </div>
  </div>
</section>

<script>
  // On reveal: the review count ticks up and the stars light one by one. Static under reduced motion.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.getElementById('reviews');
  const counter = section?.querySelector<HTMLElement>('[data-count]');
  const stars = section?.querySelector<HTMLElement>('.stars-in');
  if (section && !reduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e?.isIntersecting) return;
        io.disconnect();
        stars?.classList.add('is-in');
        if (counter) {
          const target = Number(counter.dataset.count);
          const t0 = performance.now();
          const step = (now: number) => {
            const k = Math.min(1, (now - t0) / 1100);
            const eased = 1 - Math.pow(1 - k, 3);
            counter.textContent = Math.round(target * eased).toLocaleString('en-GB');
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.4 },
    );
    io.observe(section);
  } else {
    stars?.classList.add('is-in');
  }
</script>
