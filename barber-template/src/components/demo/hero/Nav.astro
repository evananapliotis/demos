---
/** The page's top navigation. Sits over the photo on the photo-backed heroes and on the ground on the rest. */
import type { DemoSite } from '../../../lib/demo.ts';
import Icons from '../Icons.astro';

interface Props {
  site: DemoSite;
  class?: string;
}
const { site, class: cls = '' } = Astro.props;
const nav = [
  { href: '#prices', label: 'Prices' },
  // Offered only when the page actually renders a gallery, so the anchor always lands somewhere.
  ...(site.showGallery ? [{ href: '#gallery', label: 'The work' }] : []),
  { href: '#reviews', label: 'Reviews' },
  { href: '#find-us', label: 'Find us' },
  // Offered only where the shop has agreed to online booking.
  ...(site.showBooking ? [{ href: site.bookHref, label: 'Book' }] : []),
];
---

<nav class={`relative z-20 flex items-center justify-between gap-3 px-5 pt-4 sm:px-8 lg:px-12 ${cls}`} aria-label="Primary">
  <a href="#top" class="display inline-flex min-h-11 min-w-0 items-center gap-2 text-[1.35rem] tracking-wide text-cream" aria-label={`${site.name} home`}>
    <span class="inline-block h-6 w-[7px] shrink-0 rounded-sm stripe-amber" aria-hidden="true"></span>
    <span class="truncate">{site.name}</span>
  </a>
  <ul class="flex shrink-0 items-center gap-2 text-sm font-bold" role="list">
    {nav.map((n) => (
      <li class="hidden md:block"><a href={n.href} class="inline-flex min-h-11 items-center px-3 text-cream-2 hover:text-amber">{n.label}</a></li>
    ))}
    <li>
      <a href={site.telHref} class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-[var(--radius)] px-3 text-amber hover:text-amber-2" aria-label={`Call ${site.phone.display}`}>
        <Icons name="phone" size={20} /><span class="hidden sm:inline">{site.phone.display}</span>
      </a>
    </li>
  </ul>
</nav>
