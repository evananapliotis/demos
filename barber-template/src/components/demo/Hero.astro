---
/**
 * The first screen, in one of five treatments (src/lib/theme.ts). The pieces —
 * navigation, the name, the rating pill, the actions, the small print — are the
 * same components in every treatment; only their arrangement and the photo's
 * job change.
 */
import type { DemoSite } from '../../lib/demo.ts';
import Actions from './hero/Actions.astro';
import Meta from './hero/Meta.astro';
import Name from './hero/Name.astro';
import Nav from './hero/Nav.astro';
import Rating from './hero/Rating.astro';

interface Props { site: DemoSite }
const { site } = Astro.props;
const hero = site.hero;
const variant = site.heroVariant;
const eyebrow = `${site.kind} · ${site.address.locality}`;
/** Small photos are upscaled behind the type, so they are softened rather than shown sharp. */
const soften = hero && hero.width < 1000 ? 'blur-[2px]' : '';
---

{variant === 'full-bleed' && hero && (
  <header id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink" style={site.heroVars ?? undefined}>
    {hero && (
      <img
        src={hero.path}
        alt={hero.alt}
        width={hero.width}
        height={hero.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class={`hero-photo absolute inset-0 -z-20 h-full w-full object-cover object-center opacity-[var(--hero-photo-opacity)] ${soften}`}
      />
    )}
    <div class={`absolute inset-0 -z-10 ${hero ? 'hero-scrim' : 'hero-scrim-none'}`} aria-hidden="true"></div>

    <Nav site={site} />

    <div class="relative mx-auto flex w-full max-w-6xl flex-1 flex-col px-5 pb-8 pt-2 sm:px-8 md:pb-16 md:pt-10 lg:px-12">
      <div class="relative z-10 mt-auto">
        <p class="eyebrow rise">{eyebrow}</p>
        <Name site={site} class="mt-3" />
        <Rating site={site} class="mt-5" />
        <p class="rise mt-4 max-w-md text-lg leading-snug text-cream/85 md:text-2xl" style="animation-delay:120ms">{site.tagline}</p>
        <Actions site={site} class="mt-6" />
        <Meta site={site} class="mt-6" />
      </div>
    </div>

    <a href="#prices" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-cream-2 hover:text-amber md:flex" aria-label="Scroll to the next section">
      Scroll <span class="block h-10 w-px overflow-hidden bg-cream/20"><span class="scroll-line block h-full w-full bg-amber"></span></span>
    </a>
  </header>
)}

{/*
  The ruled hero.

  A full-bleed hero is built around an image, so a layout that wants one and has
  none gives a screen of empty ground with the type parked at the bottom — a
  page that looks like its picture failed to load. This is the deliberate
  version, and it works either way: the composition is ruled rather than
  floating, the eyebrow and the rating take the top rule between them so the
  first screen starts with something in it, the name is set large enough to be
  the picture, and the tagline and the actions close it underneath. The height
  follows the content instead of reaching for a screen it cannot fill.

  Where there is a photograph it takes a column of its own beside the name,
  between the two rules, darkened to sit in the page rather than shout over it.
  Beside rather than behind: a shop's own pictures come off a phone in portrait,
  and a portrait stretched across a letterbox hero is both upscaled and cropped
  through the middle of its subject. A column shows it at close to its own size,
  the whole frame, no upscale.
*/}
{variant === 'ruled' && (
  <header id="top" class="relative isolate overflow-hidden bg-ink">
    {!hero && <div class="hero-scrim-none absolute inset-0 -z-10" aria-hidden="true"></div>}

    <Nav site={site} />

    <div class="mx-auto w-full max-w-6xl px-5 pb-12 pt-5 sm:px-8 md:pb-16 lg:px-12">
      <span class="block h-px w-full bg-cream/25" aria-hidden="true"></span>
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-4">
        <p class="eyebrow rise">{eyebrow}</p>
        <Rating site={site} />
      </div>
      <span class="block h-px w-full bg-cream/25" aria-hidden="true"></span>

      <div class={hero ? 'grid gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,0.42fr)] md:items-stretch md:gap-10' : ''}>
        <Name site={site} class="mt-6 md:mt-8 md:self-center" />
        {hero && (
          <div class="hero-photo-panel relative mt-6 overflow-hidden md:mt-8">
            <img
              src={hero.path}
              alt={hero.alt}
              width={hero.width}
              height={hero.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/10] h-full w-full object-cover object-center md:aspect-auto"
            />
            <div class="hero-photo-veil absolute inset-0" aria-hidden="true"></div>
          </div>
        )}
      </div>

      <span class="mt-6 block h-1 w-full bg-amber md:mt-8" aria-hidden="true"></span>
      <div class="mt-6 grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
        <p class="rise max-w-lg text-xl leading-tight text-cream md:text-2xl" style="animation-delay:120ms">{site.tagline}</p>
        <Meta site={site} class="md:text-right" />
      </div>
      <Actions site={site} class="mt-6" />
    </div>
  </header>
)}

{variant === 'editorial' && (
  <header id="top" class="relative bg-ink">
    <Nav site={site} />
    <div class="mx-auto w-full max-w-6xl px-5 pt-6 sm:px-8 lg:px-12">
      <span class="block h-1 w-full bg-cream" aria-hidden="true"></span>
    </div>
    <div class={`mx-auto grid w-full max-w-6xl gap-8 px-5 pb-14 pt-6 sm:px-8 md:gap-12 md:pb-24 md:pt-10 lg:px-12 ${hero ? 'md:grid-cols-[minmax(0,1fr)_minmax(0,0.58fr)]' : 'max-w-3xl'}`}>
      <div>
        <p class="eyebrow rise">{eyebrow}</p>
        <Name site={site} class="mt-4" />
        <span class="mt-7 block h-px w-full bg-cream/30" aria-hidden="true"></span>
        <p class="rise mt-6 max-w-md text-2xl leading-tight text-cream" style="animation-delay:120ms">{site.tagline}</p>
        <Rating site={site} class="mt-7" />
        <Actions site={site} class="mt-7" />
        <Meta site={site} class="mt-7" />
      </div>
      {hero && (
        <img
          src={hero.path}
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[4/5] h-full w-full self-start object-cover md:mt-11"
        />
      )}
    </div>
  </header>
)}

{variant === 'type-led' && (
  <header id="top" class="relative overflow-hidden bg-ink">
    <Nav site={site} />
    <div class="mx-auto w-full max-w-6xl px-5 pb-12 pt-12 sm:px-8 md:pb-16 md:pt-24 lg:px-12">
      <p class="eyebrow rise">{eyebrow}</p>
      <Name site={site} class="mt-4" />
      <p class="rise mt-6 max-w-xl text-xl leading-snug text-cream-2 md:text-2xl" style="animation-delay:120ms">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <Rating site={site} />
        <Meta site={site} />
      </div>
      <Actions site={site} class="mt-8" />
    </div>
    {hero && (
      <img
        src={hero.path}
        alt={hero.alt}
        width={hero.width}
        height={hero.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-[38vh] w-full object-cover object-center md:h-[54vh]"
      />
    )}
  </header>
)}

{variant === 'plaque' && (
  <header id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink">
    {hero && (
      <img
        src={hero.path}
        alt={hero.alt}
        width={hero.width}
        height={hero.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class={`hero-photo absolute inset-0 -z-20 h-full w-full object-cover object-center opacity-[var(--hero-photo-opacity)] ${soften}`}
      />
    )}
    <div class={`absolute inset-0 -z-10 ${hero ? 'hero-scrim-plaque' : 'hero-scrim-none'}`} aria-hidden="true"></div>

    <Nav site={site} />

    <div class="relative flex flex-1 items-center justify-center px-4 py-10 sm:px-8">
      <div class="w-full max-w-5xl border-[3px] border-amber/70 p-2 shadow-[0_28px_70px_color-mix(in_srgb,var(--color-cream)_38%,transparent)]">
        <div class="border border-amber/45 bg-ink px-5 py-10 text-center sm:px-12 sm:py-14">
          <p class="eyebrow rise">{eyebrow}</p>
          <Name site={site} class="mt-4" />
          <span class="mx-auto mt-7 block h-0.5 w-28 bg-amber" aria-hidden="true"></span>
          <p class="rise mx-auto mt-6 max-w-lg text-lg leading-snug text-cream/90" style="animation-delay:120ms">{site.tagline}</p>
          <Rating site={site} class="mt-6" />
          <Actions site={site} center class="mt-7" />
          <Meta site={site} center class="mt-7" />
        </div>
      </div>
    </div>
  </header>
)}

{variant === 'split' && (
  <header id="top" class="relative bg-ink">
    <Nav site={site} />
    <div class={`grid items-stretch ${hero ? 'md:grid-cols-[1.06fr_1fr]' : ''}`}>
      <div class="flex flex-col justify-center px-5 pb-12 pt-10 sm:px-8 md:py-20 lg:pl-12 lg:pr-10">
        <p class="eyebrow rise">{eyebrow}</p>
        <Name site={site} class="mt-4" />
        <p class="rise mt-5 max-w-sm text-lg leading-snug text-cream-2 md:text-xl" style="animation-delay:120ms">{site.tagline}</p>
        <Rating site={site} class="mt-6 self-start" />
        <Actions site={site} class="mt-7" />
        <Meta site={site} class="mt-7" />
      </div>
      {hero && (
      <div class="relative order-first min-h-[42vh] overflow-hidden bg-ink-2 md:order-last md:min-h-[40rem]">
          <img
            src={hero.path}
            alt={hero.alt}
            width={hero.width}
            height={hero.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-center"
          />
        <div class="hero-scrim-side absolute inset-0 hidden md:block" aria-hidden="true"></div>
      </div>
      )}
    </div>
  </header>
)}

<script>
  import { paintOpenStatus } from '../../lib/open-status.ts';
  // "Open now · closes 8pm" / "Closed · opens 9am tomorrow" on the shop's clock, plus the status dots.
  paintOpenStatus();
</script>
