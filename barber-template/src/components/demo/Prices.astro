---
/* 01. A listing carries no price list, so the section asks for prices and puts the number up big. */
import type { DemoSite } from '../../lib/demo.ts';
import Section from './Section.astro';
import Icons from './Icons.astro';
interface Props { site: DemoSite; index?: string }
const { site, index } = Astro.props;
---
<Section id="prices" index={index} eyebrow="Prices" title="Ask for <span class='text-amber'>prices.</span>">
  <div data-reveal>
    <p class="max-w-md text-lg text-cream-2">Prices are not published online. Call and ask before you come in.</p>
    <a href={site.telHref} class="group mt-6 inline-flex flex-col rounded-md py-2" aria-label={`Call ${site.phone.display} for prices`}>
      <span class="eyebrow">Call for prices</span>
      <span class="display mt-1 text-[clamp(2.6rem,12.5vw,7rem)] leading-[0.95] text-amber transition-colors group-hover:text-amber-2">{site.phone.display}</span>
      <span class="mt-2 block h-[3px] w-16 bg-amber transition-[width] duration-300 group-hover:w-full" aria-hidden="true"></span>
    </a>
    <div class="mt-8">
      <a href={site.telHref} class="btn btn-amber"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
    </div>
  </div>
</Section>
