---
/* 01. The price list when the shop has given one; otherwise ask for prices and put the number up big. */
import type { DemoSite } from '../../lib/demo.ts';
import Section from './Section.astro';
import Icons from './Icons.astro';
interface Props { site: DemoSite; index?: string }
const { site, index } = Astro.props;
const prices = site.prices ?? [];
---
{prices.length ? (
  <Section id="prices" index={index} eyebrow="Prices" title="What it <span class='text-amber'>costs.</span>">
    <ul class="divide-y divide-line border-y border-line" role="list" data-reveal>
      {prices.map((p) => (
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="min-w-0">
            <span class="block text-lg font-bold text-cream">{p.name}</span>
            {p.minutes != null && <span class="text-xs font-bold uppercase tracking-[0.12em] text-cream-2">{p.minutes} min</span>}
          </span>
          <span class="display shrink-0 text-[2.2rem] leading-none text-amber">{p.price}</span>
        </li>
      ))}
    </ul>
    <div class="mt-8 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap" data-reveal>
      <a href={site.bookHref} class="btn btn-amber"><Icons name="calendar" size={19} /> Book online</a>
      <a href={site.telHref} class="btn btn-outline"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
    </div>
  </Section>
) : (
  <Section id="prices" index={index} eyebrow="Prices" title="Ask for <span class='text-amber'>prices.</span>">
    <div data-reveal>
      <p class="max-w-md text-lg text-cream-2">Prices are not published online. Call and ask before you come in.</p>
      <a href={site.telHref} class="group mt-6 inline-flex flex-col rounded-md py-2" aria-label={`Call ${site.phone.display} for prices`}>
        <span class="eyebrow">Call for prices</span>
        <span class="display mt-1 text-[clamp(2.6rem,12.5vw,7rem)] leading-[0.95] text-amber transition-colors group-hover:text-amber-2">{site.phone.display}</span>
        <span class="mt-2 block h-[3px] w-16 bg-amber transition-[width] duration-300 group-hover:w-full" aria-hidden="true"></span>
      </a>
      <div class="mt-8">
        <a href={site.telHref} class="btn btn-amber"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
      </div>
    </div>
  </Section>
)}
