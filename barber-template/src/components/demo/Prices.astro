---
/**
 * Prices: the shop's own list when it has published one, otherwise the number
 * to call, put up big.
 *
 * Where the shop offers booking, the services that can be booked follow — as
 * rows or as cards, whichever the theme sets — unless its price list already is
 * its menu, in which case those rows book directly and nothing is listed twice.
 *
 * Where it does not, that block is left out entirely rather than reprinted
 * without its links. The six services are the booking system's own list, not
 * anything the shop told us; as links they read as what the system offers, but
 * as plain text they would read as a claim about what this shop does, which we
 * cannot evidence. So a shop with no price list and no booking shows the
 * heading, one honest line and its number — and nothing else.
 */
import type { DemoSite } from '../../lib/demo.ts';
import Icons from './Icons.astro';
import Section from './Section.astro';

interface Props {
  site: DemoSite;
  index?: string;
  /** Sit on the raised ground, so two neighbouring sections never share a tone. */
  alt?: boolean;
}
const { site, index, alt = false } = Astro.props;
const prices = site.prices ?? [];
const { copy, layout } = site;
const services = site.services;
/**
 * The bookable list repeats the price list when the shop's menu and its prices
 * are the same things — every row would say the same name twice. In that case
 * the price list itself does the booking, each row a link.
 */
const sameList = site.showBooking && prices.length > 0 && prices.length === services.length && prices.every((p, i) => p.name === services[i]!.name);
/** The bookable list only exists where there is somewhere to book. */
const showServices = site.showBooking && !sameList;
/**
 * The row of buttons under the section. With no booking and no price list the
 * number is already the whole section, set large above, so a Call button three
 * inches below it would only say the same thing twice.
 */
const showButtons = site.showBooking || prices.length > 0;
const [lead, accent] = prices.length ? copy.pricesListTitle : copy.pricesAskTitle;
---

<Section id="prices" index={index} eyebrow={copy.pricesEyebrow} title={lead} accent={accent} class={alt ? 'bg-ink-2' : ''}>
  {prices.length ? (
    <ul class="divide-y divide-line border-y border-line" role="list" data-reveal>
      {prices.map((p, i) => {
        const service = sameList ? services[i] : null;
        const row = (
          <>
            <span class="min-w-0">
              <span class="block text-lg font-bold text-cream">{p.name}</span>
              {p.minutes != null && <span class="text-xs font-bold uppercase tracking-[0.12em] text-cream-2">{p.minutes} min{service && <span class="ml-3 text-amber">Book</span>}</span>}
            </span>
            <span class="display shrink-0 text-[2.2rem] leading-none text-amber">{p.price}</span>
          </>
        );
        return (
          <li>
            {service ? (
              <a href={`${site.bookHref}?service=${service.id}`} class="flex items-center justify-between gap-4 py-4 transition-colors hover:text-amber">{row}</a>
            ) : (
              <span class="flex items-center justify-between gap-4 py-4">{row}</span>
            )}
          </li>
        );
      })}
    </ul>
  ) : (
    <div data-reveal>
      <p class="max-w-md text-lg text-cream-2">{copy.pricesLede}</p>
      <a href={site.telHref} class="group mt-6 inline-flex flex-col rounded-[var(--radius)] py-2" aria-label={`Call ${site.phone.display} for prices`}>
        <span class="eyebrow">Call for prices</span>
        <span class="display mt-1 text-[clamp(2.2rem,10vw,5rem)] leading-[0.95] text-amber transition-colors group-hover:text-amber-2">{site.phone.display}</span>
        <span class="mt-2 block h-[3px] w-16 bg-amber transition-[width] duration-300 group-hover:w-full" aria-hidden="true"></span>
      </a>
    </div>
  )}

  {showServices && (
  <div class="mt-10" data-reveal>
    <h3 class="eyebrow mb-4">{copy.servicesHeading}</h3>
    {layout.services === 'cards' ? (
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2" role="list">
        {services.map((s) => (
          <li>
            <a
              href={`${site.bookHref}?service=${s.id}`}
              class={`flex min-h-[4.5rem] items-center justify-between gap-4 rounded-[var(--radius)] border border-line px-5 py-4 transition-colors hover:border-amber ${alt ? 'bg-ink' : 'bg-ink-2'}`}
            >
              <span class="text-lg font-bold text-cream">{s.name}</span>
              <span class={['shrink-0 text-xs font-bold uppercase tracking-[0.12em] text-cream-2', s.price && 'text-right'].filter(Boolean).join(' ')}>{s.minutes} min{s.price && <span class="block text-amber">{s.price}</span>}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="divide-y divide-line border-y border-line" role="list">
        {services.map((s) => (
          <li>
            <a href={`${site.bookHref}?service=${s.id}`} class="flex min-h-14 items-center justify-between gap-4 py-4 hover:text-amber">
              <span class="text-lg font-bold text-cream">{s.name}</span>
              <span class="shrink-0 text-xs font-bold uppercase tracking-[0.12em] text-cream-2">{s.minutes} min{s.price && <span class="ml-3 text-amber">{s.price}</span>}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  )}

  {showButtons && (
  <div class="mt-8 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap" data-reveal>
    {site.showBooking && <a href={site.bookHref} class="btn btn-amber"><Icons name="calendar" size={19} /> Book online</a>}
    <a href={site.telHref} class={`btn ${site.showBooking ? 'btn-outline' : 'btn-amber'}`}><Icons name="phone" size={19} /> Call {site.phone.display}</a>
  </div>
  )}
</Section>
