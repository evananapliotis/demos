---
/**
 * Prices: the shop's own list when it has published one, otherwise the number
 * to call, put up big. Either way the services that can be booked are shown
 * below it — as rows or as cards, whichever the theme sets.
 */
import type { DemoSite } from '../../lib/demo.ts';
import { SERVICES } from '../../lib/demo-booking.ts';
import Icons from './Icons.astro';
import Section from './Section.astro';

interface Props {
  site: DemoSite;
  index?: string;
  /** Sit on the raised ground, so two neighbouring sections never share a tone. */
  alt?: boolean;
}
const { site, index, alt = false } = Astro.props;
const prices = site.prices ?? [];
const { copy, layout } = site;
const [lead, accent] = prices.length ? copy.pricesListTitle : copy.pricesAskTitle;
---

<Section id="prices" index={index} eyebrow={copy.pricesEyebrow} title={lead} accent={accent} class={alt ? 'bg-ink-2' : ''}>
  {prices.length ? (
    <ul class="divide-y divide-line border-y border-line" role="list" data-reveal>
      {prices.map((p) => (
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="min-w-0">
            <span class="block text-lg font-bold text-cream">{p.name}</span>
            {p.minutes != null && <span class="text-xs font-bold uppercase tracking-[0.12em] text-cream-2">{p.minutes} min</span>}
          </span>
          <span class="display shrink-0 text-[2.2rem] leading-none text-amber">{p.price}</span>
        </li>
      ))}
    </ul>
  ) : (
    <div data-reveal>
      <p class="max-w-md text-lg text-cream-2">{copy.pricesLede}</p>
      <a href={site.telHref} class="group mt-6 inline-flex flex-col rounded-[var(--radius)] py-2" aria-label={`Call ${site.phone.display} for prices`}>
        <span class="eyebrow">Call for prices</span>
        <span class="display mt-1 text-[clamp(2.2rem,10vw,5rem)] leading-[0.95] text-amber transition-colors group-hover:text-amber-2">{site.phone.display}</span>
        <span class="mt-2 block h-[3px] w-16 bg-amber transition-[width] duration-300 group-hover:w-full" aria-hidden="true"></span>
      </a>
    </div>
  )}

  <div class="mt-10" data-reveal>
    <h3 class="eyebrow mb-4">{copy.servicesHeading}</h3>
    {layout.services === 'cards' ? (
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2" role="list">
        {SERVICES.map((s) => (
          <li>
            <a
              href={`${site.bookHref}?service=${s.id}`}
              class={`flex min-h-[4.5rem] items-center justify-between gap-4 rounded-[var(--radius)] border border-line px-5 py-4 transition-colors hover:border-amber ${alt ? 'bg-ink' : 'bg-ink-2'}`}
            >
              <span class="text-lg font-bold text-cream">{s.name}</span>
              <span class="shrink-0 text-xs font-bold uppercase tracking-[0.12em] text-cream-2">{s.minutes} min</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="divide-y divide-line border-y border-line" role="list">
        {SERVICES.map((s) => (
          <li>
            <a href={`${site.bookHref}?service=${s.id}`} class="flex min-h-14 items-center justify-between gap-4 py-4 hover:text-amber">
              <span class="text-lg font-bold text-cream">{s.name}</span>
              <span class="shrink-0 text-xs font-bold uppercase tracking-[0.12em] text-cream-2">{s.minutes} min</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="mt-8 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap" data-reveal>
    <a href={site.bookHref} class="btn btn-amber"><Icons name="calendar" size={19} /> Book online</a>
    <a href={site.telHref} class="btn btn-outline"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
  </div>
</Section>
