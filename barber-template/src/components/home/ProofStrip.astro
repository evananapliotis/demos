---
/* 2. The offer in four lines, on the same left rail as every section. */
import { COPY } from '../../lib/home.ts';
---
<section class="border-y border-amber/30 bg-amber px-5 text-ink sm:px-8 lg:px-12" aria-label="The offer in four lines">
  <ul class="mx-auto grid max-w-5xl grid-cols-1 sm:grid-cols-2 md:grid-cols-4" role="list">
    {COPY.proof.map((p) => (
      <li class="flex items-center gap-3 border-ink/15 py-3.5 [&:nth-child(n+2)]:border-t sm:pr-6 sm:[&:nth-child(-n+2)]:border-t-0 md:border-l md:px-6 md:py-5 md:first:border-l-0 md:first:pl-0 md:last:pr-0 md:[&:nth-child(n+2)]:border-t-0">
        <span class="inline-block h-5 w-[6px] shrink-0 rounded-sm bg-ink" aria-hidden="true"></span>
        <span class="display text-[1.3rem] leading-none tracking-wide sm:text-[1.4rem] lg:text-[1.3rem]">{p}</span>
      </li>
    ))}
  </ul>
</section>
