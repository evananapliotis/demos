---
import { COPY, OWNER, telHref } from '../../lib/home.ts';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
import Header from './Header.astro';
import PhoneMock from './PhoneMock.astro';
const [line1, line2] = COPY.hero.headline;
---
<header id="home" class="relative px-5 sm:px-8 lg:px-12">
  <Header />
  <div class="relative mx-auto grid w-full max-w-[76rem] gap-7 pt-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-20 lg:pb-20 lg:pt-16">
    <div>
      <p class="label fade-up" style="--d:0ms">{COPY.hero.eyebrow}</p>
      <h1 class="mt-4 text-[clamp(3.5rem,21vw,6rem)] leading-[0.9] tracking-[-0.02em] text-print lg:text-[7.5rem] xl:text-[11.5rem]" aria-label={`${line1} ${line2}`}>
        <span class="line-clip" aria-hidden="true"><span style="--d:0ms">{line1}</span></span>
        <span class="line-clip italic text-ox" aria-hidden="true"><span style="--d:90ms">{line2}</span></span>
      </h1>
      <p class="fade-up mt-5 max-w-[21rem] text-lg leading-[1.45] text-print-2 [text-wrap:pretty] lg:max-w-[30rem] lg:text-[1.375rem]" style="--d:260ms">{COPY.hero.support}</p>
      <div class="fade-up mt-6 grid grid-cols-1 gap-2.5 sm:flex sm:flex-wrap sm:gap-3" style="--d:320ms" data-hero-cta>
        <a href={OWNER.whatsapp} target="_blank" rel="noopener" class="cta cta-ink"><Wa size={18} /> WhatsApp me</a>
        <a href={telHref} class="cta cta-line"><Icons name="phone" size={18} /> Call {OWNER.phone.display}</a>
      </div>
      <p class="fade-up mt-5 flex items-start gap-3 text-[0.9375rem] font-medium text-print" style="--d:380ms"><span class="mt-[0.8em] inline-block h-[1.5px] w-6 shrink-0 bg-ox" aria-hidden="true"></span>{COPY.hero.under}</p>
      <p class="fade-up mt-2 text-[0.9375rem] text-print-2" style="--d:420ms">{COPY.hero.sent}</p>
    </div>
    <div class="relative z-10 -mb-32 flex flex-col items-center lg:mb-0 lg:items-end">
      <p class="mb-5 max-w-[18rem] text-center text-[0.8125rem] leading-snug text-print-3 lg:order-last lg:mb-0 lg:mt-5 lg:max-w-[20rem] lg:text-right">{COPY.hero.example}</p>
      <div class="relative">
        <div class="desk hidden lg:block" aria-hidden="true"></div>
        <PhoneMock />
      </div>
    </div>
  </div>
</header>
