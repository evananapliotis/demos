---
/* 11. The colophon. */
import { COPY, OWNER, telHref } from '../../lib/home.ts';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
const year = new Date().getFullYear();
---
<footer class="on-print overflow-hidden bg-print px-5 pb-10 pt-12 text-paper sm:px-8 lg:px-12 lg:pb-12 lg:pt-16">
  <div class="mx-auto max-w-[76rem]">
    <p class="mb-8 hidden whitespace-nowrap font-serif md:block text-[clamp(3rem,15vw,11rem)] leading-none tracking-[-0.02em] text-paper/[0.07]" aria-hidden="true" data-reveal>MyBarberSite</p>
    <div class="grid gap-8 md:grid-cols-[2fr_1fr_1.2fr] md:items-start md:gap-10">
      <p class="font-serif text-2xl leading-none tracking-[-0.01em]">My<i>Barber</i>Site</p>
      <div class="divide-y divide-paper/15 border-y border-paper/15">
        <a href={telHref} class="flex min-h-12 items-center gap-3 font-medium tabular-nums hover:text-paper-muted"><Icons name="phone" size={18} /> {OWNER.phone.display}</a>
        <a href={OWNER.whatsapp} target="_blank" rel="noopener" class="flex min-h-12 items-center gap-3 font-medium hover:text-paper-muted"><Wa size={18} /> WhatsApp</a>
      </div>
      <p class="max-w-[24rem] text-sm leading-normal text-paper-muted">{COPY.footer.demoLine}</p>
    </div>
    <p class="folio mt-10 border-t border-paper/15 pt-6 text-paper-muted">© {year} MyBarberSite</p>
  </div>
</footer>
