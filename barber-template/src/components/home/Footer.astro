---
import { COPY, OWNER, telHref } from '../../lib/home.ts';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
const year = new Date().getFullYear();
---
<footer class="overflow-hidden border-t border-line px-5 pb-8 pt-12 sm:px-8 lg:px-12">
  <p class="display text-outline mx-auto mb-10 max-w-5xl whitespace-nowrap text-[clamp(3rem,15vw,11.6rem)] leading-none tracking-wide opacity-40" aria-hidden="true" data-reveal>MyBarberSite</p>
  <div class="mx-auto flex max-w-5xl flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="display text-3xl text-cream">My<span class="text-amber">Barber</span>Site</p>
      <p class="mt-2"><a href={telHref} class="inline-flex min-h-12 items-center gap-2 font-bold text-cream hover:text-amber"><Icons name="phone" size={18} /> {OWNER.phone.display}</a></p>
      <p><a href={OWNER.whatsapp} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2 font-bold text-cream hover:text-amber"><Wa size={18} /> WhatsApp</a></p>
    </div>
    <p class="max-w-sm text-sm text-cream-2">{COPY.footer.demoLine}</p>
  </div>
  <p class="mx-auto mt-8 max-w-5xl text-xs text-cream-2">© {year} MyBarberSite.</p>
</footer>
