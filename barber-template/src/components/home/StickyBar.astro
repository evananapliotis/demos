---
/* 10b. WhatsApp and Call within thumb's reach on phones. Stays hidden while the hero's own buttons are on screen. */
import { OWNER, telHref } from '../../lib/home.ts';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
---
<div class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-ink/92 pb-[max(0.625rem,env(safe-area-inset-bottom))] pt-2.5 backdrop-blur md:hidden" role="region" aria-label="WhatsApp or call" data-sticky>
  <div class="mx-auto grid max-w-md grid-cols-2 gap-2.5 px-4">
    <a href={OWNER.whatsapp} target="_blank" rel="noopener" class="btn btn-amber min-h-12 text-base"><Wa size={18} /> WhatsApp</a>
    <a href={telHref} class="btn btn-outline min-h-12 text-base" aria-label={`Call ${OWNER.phone.display}`}><Icons name="phone" size={18} /> Call</a>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  const cta = document.querySelector('[data-hero-cta]');
  if (bar && cta) {
    new IntersectionObserver(([e]) => {
      if (e?.isIntersecting) delete bar.dataset.show;
      else bar.dataset.show = '';
    }).observe(cta);
  } else if (bar) {
    bar.dataset.show = '';
  }
</script>
