---
/* 10b. WhatsApp and Call within thumb's reach on phones. Stays hidden while the hero's own buttons are on screen. */
import { OWNER, telHref } from '../../lib/home.ts';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
---
<div class="fixed inset-x-0 bottom-0 z-50 border-t border-rule bg-paper/92 pb-[max(0.625rem,env(safe-area-inset-bottom))] pt-2.5 backdrop-blur-[10px] md:hidden" role="region" aria-label="WhatsApp or call" data-sticky>
  <div class="mx-auto grid max-w-md grid-cols-2 gap-2.5 px-4">
    <a href={OWNER.whatsapp} target="_blank" rel="noopener" class="cta cta-ink min-h-12"><Wa size={18} /> WhatsApp</a>
    <a href={telHref} class="cta cta-line min-h-12" aria-label={`Call ${OWNER.phone.display}`}><Icons name="phone" size={18} /> Call</a>
  </div>
</div>

<script>
  // Hidden while any of the page's own WhatsApp/Call button groups is on screen (the hero's and the closing plate's).
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  const groups = document.querySelectorAll('[data-hero-cta]');
  if (bar && groups.length) {
    const onScreen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? onScreen.add(e.target) : onScreen.delete(e.target);
      if (onScreen.size) delete bar.dataset.show;
      else bar.dataset.show = '';
    });
    groups.forEach((g) => io.observe(g));
  } else if (bar) {
    bar.dataset.show = '';
  }
</script>
