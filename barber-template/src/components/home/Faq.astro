---
/* 8. Straight answers. */
import { COPY } from '../../lib/home.ts';
import Section from '../demo/Section.astro';
import Icons from '../demo/Icons.astro';
const c = COPY.faq;
---
<Section id="answers" eyebrow="Questions" title={c.heading}>
  <div class="faq max-w-3xl divide-y divide-line border-y border-line" data-reveal>
    {c.items.map((item) => (
      <details class="group">
        <summary class="flex min-h-14 items-center justify-between gap-4 py-4 text-lg font-bold text-cream hover:text-amber md:text-xl">
          {item.q}
          <Icons name="chevron" size={20} class="faq__chev shrink-0 text-amber" />
        </summary>
        <p class="max-w-2xl pb-5 text-cream-2">{item.a}</p>
      </details>
    ))}
  </div>
</Section>
