---
/* 10. The closing ask. */
import { COPY, OFFER, OWNER, telHref } from '../../lib/home.ts';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
const c = COPY.cta;
---
<section class="relative overflow-hidden bg-amber px-5 py-16 text-ink sm:px-8 md:py-24 lg:px-12" aria-labelledby="cta-title" data-cta>
  <div class="absolute inset-y-0 right-0 w-10 stripes-move cta-stripes opacity-90 md:w-16" aria-hidden="true" data-cta-stripes></div>
  <div class="mx-auto max-w-5xl pr-8 md:pr-16" data-reveal>
    <p class="text-sm font-bold uppercase tracking-[0.18em]">£{OFFER.page} one-off <span aria-hidden="true">·</span> No monthly fee</p>
    <h2 id="cta-title" class="mt-3 text-[clamp(3rem,13vw,9.5rem)]">{c.heading}</h2>
    <p class="mt-4 max-w-md text-lg font-medium">{c.line}</p>
    <div class="mt-8 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
      <a href={OWNER.whatsapp} target="_blank" rel="noopener" class="btn btn-ink"><Wa size={19} /> WhatsApp me</a>
      <a href={telHref} class="btn border-2 border-ink text-ink hover:bg-ink hover:text-cream"><Icons name="phone" size={19} /> Call {OWNER.phone.display}</a>
    </div>
  </div>
</section>

<script>
  // The stripes only turn while the band is on screen.
  const band = document.querySelector<HTMLElement>('[data-cta]');
  const stripes = document.querySelector<HTMLElement>('[data-cta-stripes]');
  if (band && stripes) {
    new IntersectionObserver(([e]) => { stripes.toggleAttribute('data-paused', !e?.isIntersecting); }).observe(band);
  }
</script>
