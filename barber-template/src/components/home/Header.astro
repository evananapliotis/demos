---
import { OWNER, telHref } from '../../lib/home.ts';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
import Logo from './Logo.astro';
const links = [
  { href: '#what-you-get', label: 'What you get' },
  { href: '#booking', label: 'Booking' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#answers', label: 'Answers' },
];
---
<nav class="relative z-20 mx-auto flex h-16 max-w-[76rem] items-center justify-between gap-3 border-b border-rule lg:h-[4.5rem]" aria-label="Primary">
  <a href="/" class="inline-flex min-h-11 items-center gap-2.5 font-serif text-[1.375rem] leading-none tracking-[-0.01em] text-navy lg:text-2xl" aria-label="MyBarberSite home"><Logo size={22} class="shrink-0 lg:hidden" /><Logo size={24} class="hidden shrink-0 lg:block" /><span>My<i>Barber</i>Site</span></a>
  <ul class="flex shrink-0 items-center gap-1" role="list">
    {links.map((l) => (
      <li class="hidden md:block"><a href={l.href} class="inline-flex min-h-11 items-center px-3 text-[0.9375rem] font-medium text-navy-2 underline-offset-[0.2em] hover:text-navy hover:underline">{l.label}</a></li>
    ))}
    <li class="hidden md:block md:pl-2"><a href={OWNER.whatsapp} target="_blank" rel="noopener" class="cta cta-line min-h-11 px-4 text-[0.9375rem]"><Wa size={16} /> WhatsApp me</a></li>
    <li class="md:hidden">
      <a href={telHref} class="grid h-11 w-11 place-items-center rounded-[3px] bg-navy text-paper hover:bg-copper-2" aria-label={`Call ${OWNER.phone.display}`}><Icons name="phone" size={20} /></a>
    </li>
  </ul>
</nav>
