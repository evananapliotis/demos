---
/**
 * A phone showing the showcase shop's page. The page is laid out at a real
 * phone's 390px inside the screen and scrolls the way a thumb would: rest,
 * flick, rest, then one glide back to the top. Decorative: hidden from
 * assistive tech, never focusable.
 */
import Site from '../showcase/Site.astro';
import Bar from '../showcase/Bar.astro';
---
<div class="phone phone-enter" data-phone aria-hidden="true" inert>
  <div class="phone__screen">
    <div class="phone__bar flex items-end justify-between px-8 pb-2 text-[15px] font-bold">
      <span class="tabular-nums">9:41</span>
      <span class="inline-flex items-center gap-1.5" aria-hidden="true">
        <svg width="17" height="12" viewBox="0 0 17 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="0.8"/><rect x="4.5" y="6" width="3" height="6" rx="0.8"/><rect x="9" y="3.5" width="3" height="8.5" rx="0.8"/><rect x="13.5" y="0" width="3" height="12" rx="0.8"/></svg>
        <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"><path d="M8 9.6a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2zM8 6c1.6 0 3 .6 4.1 1.6l-1.5 1.5A3.9 3.9 0 0 0 8 8.2c-1 0-1.9.4-2.6.9L3.9 7.6C5 6.6 6.4 6 8 6zm0-3.4c2.5 0 4.8 1 6.5 2.6l-1.5 1.5A7.1 7.1 0 0 0 8 4.7c-1.9 0-3.7.8-5 2L1.5 5.2A9.2 9.2 0 0 1 8 2.6z"/></svg>
        <svg width="27" height="13" viewBox="0 0 27 13" fill="none" stroke="currentColor"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" opacity="0.4"/><rect x="2" y="2" width="20" height="9" rx="2" fill="currentColor" stroke="none"/><path d="M25 4.5v4a2 2 0 0 0 0-4z" fill="currentColor" stroke="none" opacity="0.4"/></svg>
      </span>
    </div>
    <div class="phone__page" data-phone-page>
      <Site />
    </div>
    <div class="phone__dock"><Bar /></div>
  </div>
  <div class="phone__notch"></div>
</div>

<script>
  const phone = document.querySelector<HTMLElement>('[data-phone]');
  const page = phone?.querySelector<HTMLElement>('[data-phone-page]');
  if (phone && page && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Scroll the page the way a thumb would: rest, flick down most of a screen, rest; one glide back to the top.
    // Frames only run while the phone is on screen and the tab is visible.
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    let raf = 0;
    let last = 0;
    let y = 0;
    let restUntil = 0;
    let move: { from: number; to: number; start: number; ms: number } | null = null;
    const tick = (t: number) => {
      raf = requestAnimationFrame(tick);
      const dt = last ? t - last : 0;
      last = t;
      if (document.hidden) {
        if (move) move.start += dt; else restUntil += dt;
        return;
      }
      if (move) {
        const p = Math.min(1, (t - move.start) / move.ms);
        y = move.from + (move.to - move.from) * ease(p);
        page.scrollTop = y;
        if (p >= 1) { move = null; restUntil = t + (y === 0 ? 2800 : 2200); }
        return;
      }
      if (t < restUntil) return;
      const max = page.scrollHeight - page.clientHeight;
      move = y >= max - 1 ? { from: y, to: 0, start: t, ms: 900 } : { from: y, to: Math.min(max, y + page.clientHeight * 0.8), start: t, ms: 650 };
    };
    const start = () => { if (!raf) { last = 0; restUntil = performance.now() + 2200; raf = requestAnimationFrame(tick); } };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };
    new IntersectionObserver(([e]) => (e?.isIntersecting ? start() : stop()), { threshold: 0.15 }).observe(phone);
  }
</script>
