---
/* 3. What a customer sees today with no page, and with one. A white Google clipping beside the showcase shop's page; made-up shop, nothing real. */
import { COPY } from '../../lib/home.ts';
import { SHOP } from '../../lib/showcase.ts';
import HomeSection from './HomeSection.astro';
import Stars from '../demo/Stars.astro';
import GoogleG from '../demo/GoogleG.astro';
import Panel from '../showcase/Panel.astro';
const c = COPY.beforeAfter;
---
<HomeSection id="before-after" label="Before and after" title={c.heading}>
  <div class="grid gap-12 md:grid-cols-2 md:gap-10 lg:gap-16">
    <div class="flex flex-col" data-reveal>
      <p class="label label-ink">{c.leftLabel}</p>
      <p class="mb-5 mt-3 max-w-[22rem] text-base leading-normal text-navy-2">{c.leftLine}</p>
      <div class="clipping mx-auto flex w-full max-w-sm flex-1 flex-col p-4 text-[#202124] md:max-w-none" aria-hidden="true" inert>
        <p class="flex items-center gap-2 text-xs font-bold text-[#5f6368]"><GoogleG size={14} /> Google</p>
        <p class="mt-3 text-2xl font-bold leading-tight">{SHOP.name}</p>
        <p class="mt-1 text-sm text-[#5f6368]">Barber shop · {SHOP.town}</p>
        <p class="mt-1 flex items-center gap-1.5 text-sm"><span class="font-bold">{SHOP.rating.toFixed(1)}</span> <Stars rating={SHOP.rating} class="text-[#fbbc04]" size={13} /> <span class="text-[#5f6368]">({SHOP.reviews})</span></p>
        <div class="mt-3 grid grid-cols-3 gap-1 md:min-h-0 md:flex-1">
          <img src={SHOP.photos[0]!.path} alt="" width={SHOP.photos[0]!.width} height={SHOP.photos[0]!.height} loading="lazy" decoding="async" class="aspect-square w-full rounded-md object-cover md:aspect-auto md:h-full md:min-h-32" />
          <div class="grid aspect-square place-items-center rounded-md bg-[#e8eaed] text-[11px] font-bold text-[#5f6368] md:aspect-auto md:min-h-32">No photo</div>
          <div class="grid aspect-square place-items-center rounded-md bg-[#e8eaed] text-[11px] font-bold text-[#5f6368] md:aspect-auto md:min-h-32">No photo</div>
        </div>
        <ul class="mt-3 divide-y divide-[#e8eaed] text-sm" role="list">
          {c.leftRows.map(([k, v]) => (
            <li class="flex justify-between py-2"><span class="text-[#5f6368]">{k}</span><span class="font-bold text-[#5f6368]">{v}</span></li>
          ))}
        </ul>
        <div class="mt-auto flex gap-2 pt-3">
          <span class="rounded-full border border-[#dadce0] px-3 py-1.5 text-xs font-bold text-[#1967d2]">Directions</span>
          <span class="rounded-full border border-[#dadce0] px-3 py-1.5 text-xs font-bold text-[#1967d2]">Call</span>
        </div>
      </div>
    </div>

    <div class="flex flex-col" data-reveal>
      <p class="label">{c.rightLabel}</p>
      <p class="mb-5 mt-3 max-w-[22rem] text-base leading-normal text-navy-2">{c.rightLine}</p>
      <div class="object mx-auto flex w-full max-w-sm flex-1 flex-col md:max-w-none" aria-hidden="true" inert>
        <Panel />
      </div>
    </div>
  </div>
</HomeSection>
