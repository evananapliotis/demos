---
/* 9. Who you are dealing with. */
import { COPY, OWNER, telHref } from '../../lib/home.ts';
import HomeSection from './HomeSection.astro';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
const c = COPY.about;
---
<HomeSection id="evangelos" label={c.eyebrow} title={c.heading}>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16" data-reveal>
    <div class="max-w-[34rem] space-y-4 font-serif text-2xl leading-[1.3] tracking-[-0.005em] text-print lg:text-[2rem]">
      {c.lines.map((l) => <p>{l}</p>)}
    </div>
    <div class="plate min-w-[16rem] divide-y divide-rule text-print">
      <a href={telHref} class="flex min-h-12 items-center gap-3 px-4 font-medium tabular-nums hover:text-ox"><Icons name="phone" size={18} /> {OWNER.phone.display}</a>
      <a href={OWNER.whatsapp} target="_blank" rel="noopener" class="flex min-h-12 items-center gap-3 px-4 font-medium hover:text-ox"><Wa size={18} /> WhatsApp me</a>
    </div>
  </div>
</HomeSection>
