---
/* 9. Who you are dealing with: the business, then a line from Evan. */
import { COPY, OWNER, telHref } from '../../lib/home.ts';
import HomeSection from './HomeSection.astro';
import Icons from '../demo/Icons.astro';
import Wa from './Wa.astro';
const c = COPY.about;
---
<HomeSection id="evan" label={c.eyebrow} title={c.heading}>
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
    <div class="max-w-[34rem] lg:col-span-6 lg:col-start-4">
      <div class="space-y-4 font-serif text-2xl leading-[1.3] tracking-[-0.005em] text-navy lg:text-[2rem]">
        {c.lines.map((l) => <p>{l}</p>)}
      </div>
      <p class="label mt-8">From Evan</p>
      <p class="mt-3 text-lg leading-[1.45] text-navy-2">{c.fromEvan}</p>
    </div>
    <div class="plate min-w-[16rem] divide-y divide-rule text-navy lg:col-span-3 lg:col-start-10 lg:justify-self-end">
      <a href={telHref} class="flex min-h-12 items-center gap-3 px-4 font-medium tabular-nums hover:text-copper-2"><Icons name="phone" size={18} /> {OWNER.phone.display}</a>
      <a href={OWNER.whatsapp} target="_blank" rel="noopener" class="flex min-h-12 items-center gap-3 px-4 font-medium hover:text-copper-2"><Wa size={18} /> WhatsApp me</a>
    </div>
  </div>
</HomeSection>
