---
/**
 * Draggable comparison. A full-size transparent range input does the
 * dragging, so touch, mouse and keyboard all work with no pointer maths.
 */
import { site } from '../config/site.ts';
import Pic from './Pic.astro';
const { beforeAfter } = site;
---

<section class="section" id="before-after" aria-labelledby="ba-heading">
  <div class="wrap">
    <div class="section-head">
      <h2 id="ba-heading">{beforeAfter.heading}</h2>
      <p class="lede">{beforeAfter.intro}</p>
    </div>
    <ul class="grid grid--3">
      {
        beforeAfter.pairs.map((pair, i) => (
          <li>
            <figure class="ba">
              <div class="ba__stage" data-ba style="--pos: 50%">
                <div class="ba__layer ba__after">
                  <Pic slot={pair.after.slot} alt={pair.after.alt} />
                </div>
                <div class="ba__layer ba__before">
                  <Pic slot={pair.before.slot} alt={pair.before.alt} />
                </div>
                <div class="ba__divider" aria-hidden="true">
                  <span class="ba__handle">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 6 3 12l6 6M15 6l6 6-6 6" />
                    </svg>
                  </span>
                </div>
                <span class="ba__label ba__label--before" aria-hidden="true">{beforeAfter.beforeLabel}</span>
                <span class="ba__label ba__label--after" aria-hidden="true">{beforeAfter.afterLabel}</span>
                <input class="ba__range" type="range" min="0" max="100" value="50" step="0.5" aria-label={`${beforeAfter.dragHint}: ${pair.caption}`} />
              </div>
              <figcaption>
                <span class="ba__n">{String(i + 1).padStart(2, '0')}</span> {pair.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ba {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .ba__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-3);
    user-select: none;
    -webkit-user-select: none;
  }
  .ba__layer {
    position: absolute;
    inset: 0;
  }
  .ba__layer :global(picture),
  .ba__layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba__before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--ink);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }
  .ba__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: var(--shadow);
  }
  .ba__label {
    position: absolute;
    top: var(--space-3);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(26, 23, 20, 0.75);
    color: var(--ink);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .ba__label--before {
    left: var(--space-3);
  }
  .ba__label--after {
    right: var(--space-3);
  }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 3rem;
    height: 100%;
  }
  .ba__range::-moz-range-thumb {
    width: 3rem;
    height: 100%;
    border: 0;
  }
  .ba__range:focus-visible {
    opacity: 1;
    outline: 3px solid var(--accent);
    outline-offset: -3px;
    background: transparent;
  }
  .ba__range:focus-visible::-webkit-slider-thumb {
    background: transparent;
  }
  figcaption {
    color: var(--ink-2);
  }
  .ba__n {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-right: var(--space-2);
  }
</style>

<script>
  for (const stage of document.querySelectorAll<HTMLElement>('[data-ba]')) {
    const range = stage.querySelector<HTMLInputElement>('.ba__range')!;
    const update = () => stage.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  }
</script>
