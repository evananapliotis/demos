---
/**
 * The front page. Which page that is depends on the build: with CLIENT_SLUG
 * set it is the client's own shop page, otherwise the MyBarberSite offer.
 * astro.config.mjs aliases virtual:front-page to one or the other, so only
 * the page that renders is in this route's module graph — a component that is
 * imported and not rendered would still inline its stylesheet here.
 */
import FrontPage from 'virtual:front-page';
---

<FrontPage />
