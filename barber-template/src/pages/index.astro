---
/**
 * The front page of mybarbersite.co.uk: the offer to UK barbershop owners,
 * with the shop pages' own components inside its mockups.
 */
import HomeBase from '../layouts/HomeBase.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import BeforeAfter from '../components/home/BeforeAfter.astro';
import WhatYouGet from '../components/home/WhatYouGet.astro';
import BookingDemo from '../components/home/BookingDemo.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Pricing from '../components/home/Pricing.astro';
import Faq from '../components/home/Faq.astro';
import AboutMe from '../components/home/AboutMe.astro';
import Cta from '../components/home/Cta.astro';
import Footer from '../components/home/Footer.astro';
import StickyBar from '../components/home/StickyBar.astro';

const title = 'MyBarberSite | Your shop online. £500 one-off, no monthly fee.';
const description = 'A page for your barbershop with your photos, your Google rating, opening hours with open now, tap to call and directions. Online booking for £400 more. Built before you pay, live in 48 hours. £500 one-off, no monthly fee.';
---

<HomeBase title={title} description={description}>
  <Hero />
  <main id="main">
    <ProofStrip />
    <BeforeAfter />
    <WhatYouGet />
    <BookingDemo />
    <HowItWorks />
    <Pricing />
    <Faq />
    <AboutMe />
    <Cta />
  </main>
  <Footer />
  <StickyBar />
</HomeBase>
