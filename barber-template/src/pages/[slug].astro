---
/**
 * One page per listing in src/data/barbers.json, at /<slug>. The page itself
 * is src/components/demo/ShopPage.astro; everything it shows is derived from
 * the listing in src/lib/demo.ts. Nothing on a page belongs to one shop, and
 * every page is noindex.
 */
import ShopPage from '../components/demo/ShopPage.astro';
import { derive } from '../lib/demo.ts';
import { shops, type Shop } from '../lib/shops.ts';

export function getStaticPaths() {
  return shops.map((shop) => ({ params: { slug: shop.slug }, props: { shop } }));
}

interface Props {
  shop: Shop;
}
---

<ShopPage site={derive(Astro.props.shop)} />
