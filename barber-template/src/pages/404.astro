---
/**
 * The site's 404, dressed like the placeholder at /. Cloudflare serves
 * dist/404.html for any path that does not exist (wrangler.jsonc).
 */
import '../styles/demo.css';
const phone = { display: '07546 685660', tel: '+447546685660' };
---

<!doctype html>
<html lang="en-GB" class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | MyBarberSite</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0e0c0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-ink text-cream antialiased">
    <main class="flex min-h-[100svh] flex-col justify-center px-5 py-16 sm:px-8 lg:px-12">
      <div class="mx-auto w-full max-w-5xl">
        <p class="eyebrow">404</p>
        <h1 class="mt-3 text-[clamp(3rem,14vw,8rem)] text-cream">Not <span class="text-amber">here.</span></h1>
        <p class="mt-4 max-w-md text-lg text-cream/85 md:text-2xl">That page doesn't exist.</p>
        <div class="mt-8 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
          <a href="/" class="btn btn-amber">Back to MyBarberSite</a>
          <a href={`tel:${phone.tel}`} class="btn btn-outline">Call {phone.display}</a>
        </div>
      </div>
    </main>
  </body>
</html>
