---
import { site, telHref, directionsUrl, fmtTime } from '@/lib/site';
import Icons from './Icons.astro';
---
<section class="relative overflow-hidden bg-amber px-5 py-16 text-ink sm:px-8 md:py-24 lg:px-12" aria-labelledby="cta-title">
  <div class="absolute inset-y-0 right-0 w-10 stripe-amber opacity-90 md:w-16" aria-hidden="true"></div>
  <div class="mx-auto max-w-5xl pr-8 md:pr-16" data-reveal>
    <p class="text-sm font-bold uppercase tracking-[0.18em]">Closes {fmtTime(site.hours.closes)} · {site.address.street}</p>
    <h2 id="cta-title" class="mt-3 text-[clamp(3rem,13vw,7.5rem)]">Ready when<br />you are.</h2>
    <div class="mt-8 grid grid-cols-1 gap-3 sm:flex">
      <a href={telHref} class="btn btn-ink"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
      <a href={directionsUrl} target="_blank" rel="noopener" class="btn border-2 border-ink text-ink hover:bg-ink hover:text-cream"><Icons name="pin" size={19} /> Directions</a>
    </div>
    {site.bookingUrl && (
      <a href={site.bookingUrl} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-11 items-center gap-2 font-bold underline underline-offset-4">Book online <Icons name="external" size={16} /></a>
    )}
  </div>
</section>
