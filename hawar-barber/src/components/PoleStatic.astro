---
/* The hero's first paint: a flat barber pole in the site palette whose stripes crawl (SMIL, paused under reduced motion). The 3D canvas fades in over it. */
---
<svg viewBox="0 0 100 240" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="chrome" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#6d675e"/><stop offset="0.28" stop-color="#e9e4da"/><stop offset="0.5" stop-color="#f8f5ee"/><stop offset="0.72" stop-color="#b9b2a6"/><stop offset="1" stop-color="#4d4840"/>
    </linearGradient>
    <linearGradient id="shade" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity="0.55"/><stop offset="0.3" stop-color="#000" stop-opacity="0"/><stop offset="0.55" stop-color="#fff" stop-opacity="0.12"/><stop offset="0.8" stop-color="#000" stop-opacity="0.1"/><stop offset="1" stop-color="#000" stop-opacity="0.6"/>
    </linearGradient>
    <pattern id="stripes" width="64" height="64" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
      <animateTransform attributeName="patternTransform" type="translate" additive="sum" from="0 0" to="0 -64" dur="2.6s" repeatCount="indefinite"/>
      <rect width="64" height="64" fill="#f4eee4"/>
      <rect width="64" height="20" fill="#f2a93b"/>
      <rect y="32" width="64" height="12" fill="#0e0c0a"/>
    </pattern>
    <clipPath id="body"><rect x="24" y="42" width="52" height="156"/></clipPath>
  </defs>
  <g transform="rotate(-6 50 120)">
    <circle cx="50" cy="20" r="15" fill="url(#chrome)"/>
    <rect x="42" y="30" width="16" height="10" fill="url(#chrome)"/>
    <rect x="18" y="36" width="64" height="12" rx="3" fill="url(#chrome)"/>
    <g clip-path="url(#body)">
      <rect x="24" y="42" width="52" height="156" fill="url(#stripes)"/>
      <rect x="24" y="42" width="52" height="156" fill="url(#shade)"/>
    </g>
    <rect x="18" y="192" width="64" height="12" rx="3" fill="url(#chrome)"/>
    <rect x="42" y="204" width="16" height="30" fill="url(#chrome)"/>
  </g>
</svg>
