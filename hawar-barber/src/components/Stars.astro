---
interface Props { rating: number; class?: string; size?: number }
const { rating, class: cls = '', size = 14 } = Astro.props;
const full = Math.round(rating);
---
<span class={`inline-flex items-center gap-[2px] ${cls}`} aria-hidden="true">
  {Array.from({ length: 5 }).map((_, i) => (
    <svg width={size} height={size} viewBox="0 0 24 24" fill={i < full ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
      <path d="M12 2.8l2.9 6.1 6.7.8-4.9 4.6 1.3 6.6L12 17.6 6 20.9l1.3-6.6L2.4 9.7l6.7-.8z" />
    </svg>
  ))}
</span>
