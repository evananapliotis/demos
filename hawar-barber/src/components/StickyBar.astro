---
import { site, telHref, directionsUrl, bookHref, bookExternal } from '@/lib/site';
import Icons from './Icons.astro';
interface Props { book?: boolean }
const { book = true } = Astro.props;
const showBook = book && !!bookHref;
---
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-ink/92 pb-[max(0.625rem,env(safe-area-inset-bottom))] pt-2.5 backdrop-blur"
  role="region"
  aria-label={showBook ? 'Book, call or get directions' : 'Call or get directions'}
>
  <div class={`mx-auto grid max-w-md gap-2 px-3 ${showBook ? 'grid-cols-[1.15fr_1fr_1fr]' : 'grid-cols-2 gap-2.5 px-4'}`}>
    {showBook && (
      <a href={bookHref} class="btn btn-amber min-h-12 px-2 text-[0.95rem]" target={bookExternal ? '_blank' : undefined} rel={bookExternal ? 'noopener' : undefined}>
        <Icons name="calendar" size={18} class="hidden min-[360px]:block" /> Book
      </a>
    )}
    <a href={telHref} class={`btn ${showBook ? 'btn-outline px-2 text-[0.95rem]' : 'btn-amber text-base'} min-h-12`} aria-label={`Call ${site.phone.display}`}><Icons name="phone" size={18} /> Call</a>
    <a href={directionsUrl} target="_blank" rel="noopener" class={`btn btn-outline min-h-12 ${showBook ? 'px-2 text-[0.95rem]' : 'text-base'}`} aria-label="Directions">
      <Icons name="pin" size={18} class={showBook ? 'hidden min-[360px]:block' : ''} />
      {showBook ? <><span class="min-[400px]:hidden">Map</span><span class="hidden min-[400px]:inline">Directions</span></> : 'Directions'}
    </a>
  </div>
</div>
