---
import { Image } from 'astro:assets';
import { site, telHref, directionsUrl, listingUrl, bookHref, bookExternal, openDaysLabel } from '@/lib/site';
import { heroImage, altFor } from '@/lib/images';
import Icons from './Icons.astro';
import Stars from './Stars.astro';
import GoogleG from './GoogleG.astro';
import PoleStatic from './PoleStatic.astro';
const [first, ...rest] = site.name.split(' ');
const second = rest.join(' ');
const letters = (word: string, offset: number) => [...word].map((ch, i) => ({ ch, i: i + offset }));
---
<header id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink">
  {
    heroImage && (
      <Image
        src={heroImage}
        alt={altFor(site.images.hero)}
        widths={[480, 768, 1080, 1440]}
        sizes="100vw"
        layout="full-width"
        format="webp"
        quality={70}
        loading="eager"
        fetchpriority="high"
        class={`absolute inset-0 -z-20 !h-full !w-full object-cover object-center opacity-45 ${heroImage.width < 1000 ? 'scale-105 blur-[2px]' : ''}`}
      />
    )
  }
  <div
    class={`absolute inset-0 -z-10 ${
      heroImage
        ? 'bg-[linear-gradient(to_bottom,rgb(14_12_10/0.85),rgb(14_12_10/0.35)_22%,rgb(14_12_10/0.55)_50%,rgb(14_12_10)_78%),radial-gradient(90%_60%_at_100%_0%,rgb(242_169_59/0.12),transparent_60%)]'
        : 'bg-[radial-gradient(90%_60%_at_100%_0%,rgb(242_169_59/0.16),transparent_60%),linear-gradient(to_bottom,rgb(14_12_10/0.2),rgb(14_12_10)_70%)]'
    }`}
    aria-hidden="true"
  ></div>

  <nav class="relative z-20 flex items-center justify-between px-5 pt-4 sm:px-8 lg:px-12" aria-label="Primary">
    <a href="#top" class="display inline-flex min-h-11 items-center gap-2 text-[1.35rem] tracking-wide text-cream" aria-label={`${site.name} home`}>
      <span class="inline-block h-6 w-[7px] rounded-sm stripe-amber" aria-hidden="true"></span>
      {site.name}
    </a>
    <ul class="flex items-center gap-2 text-sm font-bold" role="list">
      <li class="hidden md:block"><a href="#prices" class="inline-flex min-h-11 items-center px-3 text-cream-2 hover:text-amber">Prices</a></li>
      <li class="hidden md:block"><a href="#reviews" class="inline-flex min-h-11 items-center px-3 text-cream-2 hover:text-amber">Reviews</a></li>
      <li class="hidden md:block"><a href="#find-us" class="inline-flex min-h-11 items-center px-3 text-cream-2 hover:text-amber">Find us</a></li>
      {bookHref && <li class="hidden md:block"><a href={bookHref} class="inline-flex min-h-11 items-center px-3 text-cream-2 hover:text-amber" target={bookExternal ? '_blank' : undefined} rel={bookExternal ? 'noopener' : undefined}>Book{bookExternal && <span class="sr-only"> (opens in a new tab)</span>}</a></li>}
      <li>
        <a href={telHref} class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-md px-3 text-amber hover:text-amber-2" aria-label={`Call ${site.phone.display}`}>
          <Icons name="phone" size={20} /><span class="hidden sm:inline">{site.phone.display}</span>
        </a>
      </li>
    </ul>
  </nav>

  <div class="relative mx-auto grid w-full max-w-6xl flex-1 grid-cols-1 gap-4 px-5 pb-8 pt-2 sm:px-8 md:grid-cols-[minmax(0,1fr)_minmax(200px,30%)] md:items-center md:gap-12 md:pb-16 md:pt-10 lg:px-12">
    <div class="flex justify-end md:order-2 md:justify-center">
      <div class="relative" data-pole-wrap>
        <div class="pole-glow pointer-events-none absolute -inset-x-[60%] -inset-y-[18%] -z-10" aria-hidden="true"></div>
        <div class="pole-slot h-[clamp(10rem,25svh,19rem)] [@media(max-height:700px)_and_(max-width:767px)]:h-32 md:h-[clamp(20rem,70vh,40rem)]" data-pole-slot aria-hidden="true">
          <PoleStatic />
        </div>
        <script is:inline>
          // Runs during parse, before first paint: when WebGL exists the flat SVG never shows and
          // the 3D pole takes the slot. The SVG only stays for no-JS, no-WebGL, or a failed 3D load.
          try {
            var c = document.createElement('canvas');
            if (c.getContext('webgl2') || c.getContext('webgl')) document.querySelector('[data-pole-slot]').classList.add('wants-3d');
          } catch (e) {}
        </script>
      </div>
    </div>

    <div class="relative z-10 mt-auto md:order-1">
      <p class="eyebrow rise">Barber shop · {site.address.locality}</p>
      <h1 class="mt-3 text-[clamp(4rem,26vw,12.5rem)] text-cream" aria-label={site.name}>
        <span class="letters block" aria-hidden="true">{letters(first, 0).map(({ ch, i }) => <span class="letter" style={`--i:${i}`}>{ch}</span>)}</span>
        <span class="letters block text-amber" aria-hidden="true">{letters(second, first.length).map(({ ch, i }) => <span class="letter" style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}</span>
      </h1>

      <a
        href={listingUrl}
        target="_blank"
        rel="noopener"
        class="rise shimmer relative mt-5 inline-flex min-h-12 flex-wrap items-center gap-x-3 gap-y-1 overflow-hidden rounded-md border border-cream/20 bg-ink-2/80 px-3.5 py-2 text-base font-bold text-cream hover:border-amber"
        style="animation-delay:60ms"
        aria-label={`Rated ${site.google.rating.toFixed(1)} from ${site.google.reviewCount} Google reviews. Open the Google listing.`}
      >
        <span class="inline-flex items-center gap-2.5"><span class="display text-2xl leading-none text-amber">{site.google.rating.toFixed(1)}</span><Stars rating={site.google.rating} class="text-amber" size={15} /></span>
        <span class="inline-flex items-center gap-1.5 whitespace-nowrap">{site.google.reviewCount} Google reviews <GoogleG size={16} /></span>
      </a>

      <p class="rise mt-4 max-w-md text-lg leading-snug text-cream/85 md:text-2xl" style="animation-delay:120ms">{site.tagline}</p>

      <div class="mt-6 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
        <a href={telHref} class="btn btn-amber"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
        {bookHref && <a href={bookHref} class="btn btn-outline" target={bookExternal ? '_blank' : undefined} rel={bookExternal ? 'noopener' : undefined}><Icons name="calendar" size={19} /> Book a time{bookExternal && <><Icons name="external" size={14} /><span class="sr-only">(opens in a new tab)</span></>}</a>}
        <a href={directionsUrl} target="_blank" rel="noopener" class={`btn btn-outline ${bookHref ? 'hidden sm:inline-flex' : ''}`}><Icons name="pin" size={19} /> Directions</a>
      </div>

      <p class="rise mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-cream-2" style="animation-delay:180ms">
        <span class="inline-flex items-center gap-1.5"><Icons name="pin" size={14} class="text-amber" /> {site.address.street}, {site.address.postcode}</span>
        <span class="inline-flex items-center gap-1.5"><Icons name="clock" size={14} class="text-amber" /> <span data-open-status data-week={JSON.stringify(site.hours.week)}>{openDaysLabel()}</span></span>
      </p>
    </div>
  </div>

  <a href="#prices" class="scroll-cue absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-cream-2 hover:text-amber md:flex" aria-label="Scroll to prices">
    Scroll <span class="block h-10 w-px overflow-hidden bg-cream/20"><span class="scroll-line block h-full w-full bg-amber"></span></span>
  </a>
</header>

<script>
  // "Open now · closes 6:15pm" / "Closed · opens 8:30am tomorrow", from the weekly hours in the config.
  const status = document.querySelector<HTMLElement>('[data-open-status]');
  if (status?.dataset.week) {
    type Range = { open: string; close: string } | null;
    const week = JSON.parse(status.dataset.week) as Record<string, Range>;
    const names = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
    const short = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const toMin = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
    const fmt = (t: string) => { const [h, m] = t.split(':').map(Number); const s = h >= 12 ? 'pm' : 'am'; const hh = h % 12 || 12; return m ? `${hh}:${String(m).padStart(2, '0')}${s}` : `${hh}${s}`; };
    const now = new Date();
    const d = now.getDay();
    const mins = now.getHours() * 60 + now.getMinutes();
    const today = week[names[d]];
    let text = '';
    if (today && mins >= toMin(today.open) && mins < toMin(today.close)) text = `Open now · closes ${fmt(today.close)}`;
    else {
      for (let i = 0; i < 7; i++) {
        const nd = (d + i) % 7;
        const h = week[names[nd]];
        if (!h || (i === 0 && mins >= toMin(h.open))) continue;
        text = `Closed · opens ${fmt(h.open)} ${i === 0 ? 'today' : i === 1 ? 'tomorrow' : short[nd]}`;
        break;
      }
    }
    if (text) status.textContent = text;
  }

  const slot = document.querySelector<HTMLElement>('[data-pole-slot]');
  const wrap = document.querySelector<HTMLElement>('[data-pole-wrap]');
  const hero = document.getElementById('top');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  // Static pole: the stripes crawl via SMIL; hold still under reduced motion.
  const svg = slot?.querySelector('svg') as SVGSVGElement | null;
  if (svg && reduced.matches) svg.pauseAnimations?.();

  // Scroll state shared with the 3D module: progress through the hero and velocity.
  // The pole wrapper also parallaxes, shrinks and fades as the page scrolls past it.
  if (slot && wrap && hero && !reduced.matches) {
    let lastY = scrollY;
    let lastT = performance.now();
    let v = 0;
    let ticking = false;
    const tick = () => {
      const now = performance.now();
      const dt = Math.max(1, now - lastT);
      const y = scrollY;
      v = v * 0.8 + ((y - lastY) / dt) * 0.2;
      lastY = y;
      lastT = now;
      const h = hero.offsetHeight || innerHeight;
      const p = Math.min(1, Math.max(0, y / (h * 0.85)));
      slot.dataset.p = p.toFixed(4);
      slot.dataset.v = v.toFixed(4);
      wrap.style.transform = `translate3d(0, ${(p * h * 0.42).toFixed(1)}px, 0) scale(${(1 - 0.22 * p).toFixed(3)})`;
      wrap.style.opacity = (1 - 0.9 * p).toFixed(3);
      if (Math.abs(v) > 0.002 || y !== scrollY) requestAnimationFrame(tick);
      else ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(tick);
    };
    addEventListener('scroll', onScroll, { passive: true });
    wrap.style.transformOrigin = '70% 40%';
    wrap.style.willChange = 'transform, opacity';
    tick();
  }

  // 3D pole: always, as soon as the page script runs, wherever WebGL exists (the inline check above
  // marked the slot `wants-3d`). Reduced motion keeps the 3D pole but stills its idle motion (pole.ts).
  // The flat SVG comes back only if the chunk fails to load or the renderer cannot start.
  // The name, rating and Call button are plain HTML and never wait on any of this.
  if (slot?.classList.contains('wants-3d')) {
    const fallback = () => slot.classList.remove('wants-3d');
    import('../hero3d/pole')
      .then((m) => m.mount(slot))
      .catch(fallback);
    // Safety net: if no frame has rendered after a while (very slow network), show the SVG until it does.
    const guard = () => {
      if (slot.classList.contains('has-3d')) return;
      if (document.hidden) return void setTimeout(guard, 2000);
      fallback();
    };
    setTimeout(guard, 8000);
  }
</script>
