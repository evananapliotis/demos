---
interface Props { name: 'phone' | 'pin' | 'arrow' | 'wheelchair' | 'clock' | 'facebook' | 'external'; size?: number; class?: string }
const { name, size = 20, class: cls = '' } = Astro.props;
const common = { class: cls, width: size, height: size, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round' as const, 'stroke-linejoin': 'round' as const, 'aria-hidden': 'true', focusable: 'false' };
---
{name === 'phone' && (
  <svg {...common}><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/></svg>
)}
{name === 'pin' && (
  <svg {...common}><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
)}
{name === 'arrow' && (
  <svg {...common}><path d="M5 12h14M13 6l6 6-6 6"/></svg>
)}
{name === 'external' && (
  <svg {...common}><path d="M7 17L17 7M9 7h8v8"/></svg>
)}
{name === 'clock' && (
  <svg {...common}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
)}
{name === 'wheelchair' && (
  <svg {...common}><circle cx="15" cy="4" r="1.6"/><path d="M13 7l1 6h5l2 6"/><path d="M13 13H9"/><path d="M10 10a6 6 0 1 0 6.5 8"/></svg>
)}
{name === 'facebook' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3z"/></svg>
)}
