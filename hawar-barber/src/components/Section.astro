---
interface Props { id: string; eyebrow: string; title: string; class?: string; titleClass?: string }
const { id, eyebrow, title, class: cls = '', titleClass = '' } = Astro.props;
---
<section id={id} class={`scroll-mt-14 px-5 py-16 sm:px-8 md:py-24 lg:px-12 ${cls}`} aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 md:mb-12" data-reveal>
      <p class="eyebrow flex items-center gap-3 before:block before:h-[2px] before:w-6 before:bg-amber">{eyebrow}</p>
      <h2 id={`${id}-title`} class={`mt-3 text-[clamp(2.75rem,11vw,6rem)] text-cream ${titleClass}`} set:html={title} />
    </div>
    <slot />
  </div>
</section>
