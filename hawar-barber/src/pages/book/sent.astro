---
/* Landing page for the no-JavaScript form post. */
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import StickyBar from '@/components/StickyBar.astro';
import Icons from '@/components/Icons.astro';
import { site, telHref } from '@/lib/site';
---
<Base title={`Request sent | ${site.name}`} description={site.booking.confirmNote} noindex>
  <PageHeader />
  <main id="main" class="px-5 pb-16 pt-8 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-lg">
      <p class="eyebrow">Request sent</p>
      <h1 class="mt-3 text-[clamp(3rem,15vw,6rem)] text-cream">Nice <span class="text-amber">one.</span></h1>
      <p class="mt-4 text-lg text-cream/85">{site.booking.confirmNote}</p>
      <div class="mt-8 grid grid-cols-1 gap-3 sm:flex">
        <a href="/" class="btn btn-outline">Back to the shop</a>
        <a href={telHref} class="btn btn-outline"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
      </div>
    </div>
  </main>
  <StickyBar />
</Base>
