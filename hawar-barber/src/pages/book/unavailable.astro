---
/* Shown when the form is posted without JavaScript and the database is not configured. */
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import StickyBar from '@/components/StickyBar.astro';
import Icons from '@/components/Icons.astro';
import { site, telHref } from '@/lib/site';
---
<Base title={`Call the shop | ${site.name}`} description={`Call ${site.name} on ${site.phone.display} to book.`} noindex>
  <PageHeader />
  <main id="main" class="px-5 pb-16 pt-8 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-lg">
      <p class="eyebrow">Online requests are off right now</p>
      <h1 class="mt-3 text-[clamp(3rem,15vw,6rem)] text-cream">Call the <span class="text-amber">shop.</span></h1>
      <p class="mt-4 text-lg text-cream/85">Booking requests aren’t being taken online at the moment. Call the shop, or send a text with the day and time you’d like.</p>
      <div class="mt-8 grid grid-cols-1 gap-3 sm:flex">
        <a href={telHref} class="btn btn-amber"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
        <a href={`sms:${site.phone.tel}`} class="btn btn-outline">Text the shop</a>
      </div>
    </div>
  </main>
  <StickyBar />
</Base>
