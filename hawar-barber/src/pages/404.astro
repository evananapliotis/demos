---
export const prerender = true;
/* Prerendered 404: served by the CDN, so stray URLs never invoke the Worker. */
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import StickyBar from '@/components/StickyBar.astro';
import Icons from '@/components/Icons.astro';
import { site, telHref } from '@/lib/site';
---
<Base title={`Page not found | ${site.name}`} description={site.description} noindex>
  <PageHeader />
  <main id="main" class="px-5 pb-16 pt-8 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-lg">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-[clamp(3rem,15vw,6rem)] text-cream">Not <span class="text-amber">here.</span></h1>
      <p class="mt-4 text-lg text-cream/85">That page doesn’t exist. The shop does: {site.address.street}, {site.address.locality}.</p>
      <div class="mt-8 grid grid-cols-1 gap-3 sm:flex">
        <a href="/" class="btn btn-amber">Back to the shop</a>
        <a href={telHref} class="btn btn-outline"><Icons name="phone" size={19} /> Call {site.phone.display}</a>
      </div>
    </div>
  </main>
  <StickyBar />
</Base>
