---
import { client } from '../lib/client';
import CallButton from './CallButton.astro';
const o = client.offer;
---
<section class="surface-accent text-paper" aria-labelledby="students">
  <div class="section gutter md:grid md:grid-cols-12 md:items-end md:gap-x-10">
    <div class="md:col-span-7">
      <p class="label label-rule text-white/80" data-reveal>{o.label}</p>
      <p class="display big-size mt-4 -ml-[0.04em] text-gold-soft" data-reveal aria-hidden="true">{o.big}</p>
      <h2 id="students" class="display h2-size mt-2 text-white" data-reveal data-reveal-delay="1">
        <span class="sr-only">{o.big}. </span>{o.heading}
      </h2>
    </div>
    <div class="md:col-span-5 md:pb-3">
      <div class="mt-10 h-px w-16 bg-gold md:mt-0" data-reveal aria-hidden="true"></div>
      <p class="mt-8 max-w-[40ch] text-lg leading-relaxed text-white/85" data-reveal data-reveal-delay="1">{o.body}</p>
      <div class="mt-10" data-reveal data-reveal-delay="2">
        <CallButton label={o.cta} variant="paper" class="w-full md:w-auto" />
      </div>
    </div>
  </div>
</section>
