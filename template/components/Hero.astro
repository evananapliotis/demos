---
import { client, telHref } from '../lib/client';
import CallButton from './CallButton.astro';
interface Props { img: { src: string; srcSet: string; sizes: string; width: number; height: number } }
const { img } = Astro.props;
const h = client.hero;
---
<section id="top" class="relative isolate flex min-h-svh flex-col justify-end overflow-hidden" aria-labelledby="site-title">
  <img
    src={img.src} srcset={img.srcSet} sizes={img.sizes}
    width={img.width} height={img.height}
    alt={h.alt} loading="eager" fetchpriority="high" decoding="sync"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    style={`object-position:${h.position ?? '50% 50%'}`}
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(10_10_11/0.97)_0%,rgb(11_13_24/0.78)_32%,rgb(12_17_36/0.22)_60%,rgb(10_10_11/0)_82%)]" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-72 bg-[radial-gradient(80%_100%_at_0%_100%,rgb(47_91_224/0.28),transparent_70%)]" aria-hidden="true"></div>
  <div class="absolute inset-x-0 top-0 -z-10 h-28 bg-[linear-gradient(to_bottom,rgb(10_10_11/0.55),rgb(10_10_11/0))]" aria-hidden="true"></div>

  <div class="absolute inset-x-0 top-0 z-10">
    <div class="gutter flex items-center justify-between py-5 text-paper/90">
      <span class="display text-lg uppercase tracking-[0.06em]">{client.name.split(' ')[0]}</span>
      <a href={telHref} class="text-sm font-medium tracking-wide text-paper/80 transition-colors hover:text-paper">{client.phone.display}</a>
    </div>
  </div>

  <div class="gutter relative pb-10 pt-40 md:pb-16">
    <p class="label label-rule mb-6">{h.label}</p>
    <h1 id="site-title" class="display h1-size uppercase text-paper md:max-w-[12ch]">{client.name}</h1>
    <p class="mt-6 max-w-[30ch] text-lg leading-snug text-paper/85 md:text-xl">{h.line.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>

    <div class="mt-8 flex flex-col gap-6 md:flex-row md:items-center md:gap-10">
      <CallButton label={`Call ${client.phone.display}`} class="w-full md:w-auto" />
      <a href={client.rating.url} rel="noopener" target="_blank" class="inline-flex items-center gap-3 self-start rounded-full border border-paper/20 px-4 py-2 text-[0.9375rem] text-paper/85 transition-colors duration-200 hover:border-gold/60 hover:text-paper md:self-auto">
        <span class="text-gold" aria-hidden="true">★★★★★</span>
        <span><strong class="font-semibold text-paper">{client.rating.value}</strong> · {client.rating.count} Google reviews</span>
      </a>
    </div>
  </div>
</section>
