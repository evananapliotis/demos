---
import type { GetImageResult } from 'astro';
import { site, hoursSummary } from '@/lib/client';
import Icons from './Icons.astro';
import Stars from './Stars.astro';

interface Props {
  /** Pre-computed via getImage() in the page so the <head> preload and this <img> share URLs. */
  hero: GetImageResult | null;
}
const { hero } = Astro.props;
---
<header class="relative isolate min-h-[100svh] flex flex-col justify-end overflow-hidden bg-ink">
  {
    hero && (
      <img
        src={hero.src}
        srcset={hero.srcSet.attribute}
        sizes="100vw"
        width={hero.attributes.width}
        height={hero.attributes.height}
        alt={site.hero.alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(11_10_8)_0%,rgb(11_10_8/0.85)_28%,rgb(11_10_8/0.35)_60%,rgb(11_10_8/0.55)_100%)]"></div>

  <nav class="absolute inset-x-0 top-0 flex items-center justify-between px-5 py-5 sm:px-8" aria-label="Primary">
    <a href="#top" class="font-display text-lg font-semibold tracking-tight text-bone" aria-label={`${site.name} home`}>
      {site.name.split(' ')[0]}<span class="text-brass">.</span>
    </a>
    <ul class="hidden items-center gap-7 text-sm font-semibold text-bone/80 md:flex" role="list">
      <li><a href="#services" class="inline-flex min-h-11 items-center hover:text-brass">Prices</a></li>
      <li><a href="#reviews" class="inline-flex min-h-11 items-center hover:text-brass">Reviews</a></li>
      <li><a href="#hours" class="inline-flex min-h-11 items-center hover:text-brass">Hours</a></li>
      <li>
        <a href={`tel:${site.phone.tel}`} class="inline-flex min-h-11 items-center gap-2 text-bone hover:text-brass">
          <Icons name="phone" size={16} class="text-brass" /> {site.phone.display}
        </a>
      </li>
    </ul>
  </nav>

  <div class="relative px-5 pb-28 pt-40 sm:px-8 md:pb-20 md:pt-52 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <a
        href={site.google.listingUrl}
        target="_blank"
        rel="noopener"
        class="mb-6 inline-flex min-h-11 items-center gap-2 rounded-full border border-bone/25 bg-ink/50 px-4 py-2 text-sm font-semibold text-bone backdrop-blur-sm hover:border-brass"
      >
        <span class="text-brass">{site.google.rating.toFixed(1)}</span>
        <Stars rating={site.google.rating} class="text-brass" size={13} />
        <span class="text-bone/60">·</span>
        <span>{site.google.reviewCount} Google reviews</span>
      </a>

      <h1 class="font-display text-[clamp(3.4rem,15vw,9.5rem)] leading-[0.88] text-bone">
        {site.name.replace(/ Barber Shop$/i, '')}<br />
        <span class="italic font-normal text-brass">Barber Shop</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg text-bone/85 sm:text-xl md:text-2xl md:leading-snug">{site.tagline}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={`tel:${site.phone.tel}`} class="btn btn-brass">
          <Icons name="phone" size={18} /> Call {site.phone.display}
        </a>
        <a href={`https://wa.me/${site.phone.whatsapp}`} target="_blank" rel="noopener" class="btn btn-ghost">
          <Icons name="whatsapp" size={18} /> WhatsApp us
        </a>
      </div>

      <p class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-bone-2">
        <span class="inline-flex items-center gap-1.5"><Icons name="pin" size={14} class="text-brass" /> {site.address.street}, {site.address.locality} {site.address.postcode}</span>
        <span class="hidden sm:inline text-bone/30">|</span>
        <span data-hours={JSON.stringify(site.hours)}>{hoursSummary()}</span>
      </p>
    </div>
  </div>
</header>

<script>
  // Swap the static hours line for "Open now · closes 6pm" / "Closed · opens Mon 9am".
  const el = document.querySelector<HTMLElement>('[data-hours]');
  if (el) {
    const hours: Record<string, { open: string; close: string } | null> = JSON.parse(el.dataset.hours!);
    const now = new Date();
    const d = now.getDay();
    const mins = now.getHours() * 60 + now.getMinutes();
    const toMin = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
    const fmt = (t: string) => { const [h, m] = t.split(':').map(Number); const s = h >= 12 ? 'pm' : 'am'; const hh = h % 12 || 12; return m ? `${hh}:${String(m).padStart(2, '0')}${s}` : `${hh}${s}`; };
    const names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const today = hours[String(d)];
    let text = '';
    if (today && mins >= toMin(today.open) && mins < toMin(today.close)) {
      text = `Open now · closes ${fmt(today.close)}`;
    } else {
      for (let i = 0; i < 7; i++) {
        const nd = (d + i) % 7;
        const h = hours[String(nd)];
        if (!h) continue;
        if (i === 0 && mins >= toMin(h.open)) continue;
        text = `Closed · opens ${i === 0 ? 'today' : i === 1 ? 'tomorrow' : names[nd]} ${fmt(h.open)}`;
        break;
      }
    }
    if (text) el.textContent = text;
  }
</script>
