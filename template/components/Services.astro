---
import { client } from '../lib/client';
import SectionHead from './SectionHead.astro';
const s = client.services;
---
<section class="section hairline" aria-labelledby="services">
  <div class="gutter md:grid md:grid-cols-12 md:gap-x-12">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-24">
        <SectionHead id="services" label={s.label} heading={s.heading} bare />
        {s.intro && <p class="mt-8 max-w-[38ch] text-paper/80" data-reveal data-reveal-delay="1">{s.intro}</p>}
        {(s.pricingLabel || s.pricingNote) && (
          <div class="mt-10 border-l border-gold/60 pl-5" data-reveal data-reveal-delay="2">
            {s.pricingLabel && <p class="label text-gold">{s.pricingLabel}</p>}
            {s.pricingNote && <p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-relaxed text-paper/75">{s.pricingNote}</p>}
          </div>
        )}
      </div>
    </div>
    <ol class="mt-14 md:col-span-7 md:mt-0" role="list">
      {s.items.map((it, i) => (
        <li class="hairline grid grid-cols-[2.75rem_1fr_auto] items-baseline gap-x-3 py-7 first:border-t-0 md:py-8" data-reveal data-reveal-delay={String(Math.min(i % 3, 2))}>
          <span class="label pt-1 text-gold/80" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="display text-[2rem] leading-none md:text-[2.5rem]">{it.name}</h3>
            {it.note && <p class="mt-3 max-w-[36ch] text-[0.9375rem] leading-relaxed text-muted">{it.note}</p>}
          </div>
          {it.price && <span class="display text-3xl tabular-nums text-gold-soft md:text-4xl">{it.price}</span>}
        </li>
      ))}
    </ol>
  </div>
</section>
