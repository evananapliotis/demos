---
import { client, telHref } from '../lib/client';
const s = client.sticky ?? {};
---
<div id="sticky-call" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-paper/10 bg-ink/92 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-16px_40px_-12px_rgb(0_0_0/0.8)] backdrop-blur-sm transition-transform duration-300 ease-out md:hidden" aria-hidden="true">
  <div class="flex items-center gap-4">
    {(s.line1 || s.line2) && (
      <p class="min-w-0 shrink text-[0.75rem] leading-snug text-paper/70">
        {s.line1 && <span class="block font-semibold text-paper/90">{s.line1}</span>}
        {s.line2 && <span class="block">{s.line2}</span>}
      </p>
    )}
    <a href={telHref} class="btn min-h-[3.25rem] flex-1 px-4" tabindex="-1">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      </svg>
      <span>Call {client.phone.display}</span>
    </a>
  </div>
</div>
<script>
  const bar = document.getElementById('sticky-call');
  const hero = document.getElementById('top');
  const link = bar?.querySelector('a');
  if (bar && hero && link) {
    const show = (on: boolean) => {
      bar.classList.toggle('translate-y-full', !on);
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
      link.tabIndex = on ? 0 : -1;
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => show(!e.isIntersecting), { threshold: 0.05 }).observe(hero);
    } else {
      show(true);
    }
  }
</script>
