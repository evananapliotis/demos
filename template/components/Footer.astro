---
import { site, fullAddress } from '@/lib/client';
const year = new Date().getFullYear();
---
<footer class="border-t border-line px-5 pb-28 pt-12 sm:px-8 md:pb-12 lg:px-12">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-display text-3xl font-semibold text-bone">{site.name}</p>
      <p class="mt-2 text-bone-2">{fullAddress}</p>
      <p class="mt-1"><a href={`tel:${site.phone.tel}`} class="inline-flex min-h-11 items-center text-bone hover:text-brass">{site.phone.display}</a></p>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-bone-2" role="list">
        <li><a href="#services" class="inline-flex min-h-11 items-center hover:text-brass">Prices</a></li>
        <li><a href="#reviews" class="inline-flex min-h-11 items-center hover:text-brass">Reviews</a></li>
        <li><a href="#hours" class="inline-flex min-h-11 items-center hover:text-brass">Hours</a></li>
        <li><a href={site.google.listingUrl} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center hover:text-brass">Google</a></li>
        {(site.socials ?? []).map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center hover:text-brass">{s.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <p class="mx-auto mt-8 max-w-6xl text-xs text-bone/50">© {year} {site.name}. All rights reserved.</p>
</footer>
