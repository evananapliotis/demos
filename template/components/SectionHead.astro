---
interface Props { label: string; heading: string; id?: string; tone?: 'dark' | 'light'; class?: string; bare?: boolean }
const { label, heading, id, tone = 'dark', class: cls = '', bare = false } = Astro.props;
---
<header class:list={[!bare && 'gutter', cls]} data-reveal>
  <p class:list={['label label-rule mb-5', tone === 'light' && 'text-ink/70']}>{label}</p>
  <h2 id={id} class:list={['display h2-size max-w-[12ch]', tone === 'light' ? 'text-ink' : 'text-paper']}>{heading}</h2>
</header>
