---
import { site, hoursRows, fmt, fullAddress } from '@/lib/client';
import Section from './Section.astro';
import Icons from './Icons.astro';
const rows = hoursRows();
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.google.mapQuery)}&z=16&output=embed`;
const today = new Date().getDay();
---
<Section id="hours" number="05" eyebrow="Hours & where" title="Find <em class='italic text-brass font-normal'>us.</em>">
  <div class="grid gap-10 md:grid-cols-2 md:gap-16">
    <div>
      <h3 class="eyebrow mb-4">Opening hours</h3>
      <table class="w-full border-collapse text-lg">
        <caption class="sr-only">Opening hours for {site.name}</caption>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t border-line last:border-b">
              <th scope="row" class="py-3 pr-4 text-left font-medium text-bone">{r.day}</th>
              <td class={`py-3 text-right tabular-nums ${r.closed ? 'text-bone-2' : 'text-bone'}`}>
                {r.closed ? 'Closed' : `${fmt(r.open!)} – ${fmt(r.close!)}`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {site.hoursNote && <p class="mt-4 text-sm text-bone-2">{site.hoursNote}</p>}

      <h3 class="eyebrow mb-3 mt-10">Address</h3>
      <address class="not-italic text-lg text-bone">
        {site.name}<br />
        {site.address.street}<br />
        {site.address.locality} {site.address.postcode}
      </address>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a href={site.google.listingUrl} target="_blank" rel="noopener" class="btn btn-ghost">
          <Icons name="pin" size={18} /> Directions
        </a>
        <a href={`tel:${site.phone.tel}`} class="btn btn-ghost"><Icons name="phone" size={18} /> {site.phone.display}</a>
      </div>
    </div>

    <div class="min-h-[320px] overflow-hidden rounded-sm border border-line bg-ink-3 md:min-h-[520px]">
      <iframe
        title={`Map showing ${site.name} at ${fullAddress}`}
        src={mapSrc}
        width="100%"
        height="100%"
        class="h-full min-h-[320px] w-full grayscale-[0.4] contrast-[1.05] md:min-h-[520px]"
        style="border:0"
        loading="lazy"
        allowfullscreen=""
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</Section>
