---
import { client } from '../lib/client';
import SectionHead from './SectionHead.astro';
const r = client.reviews;
---
<section class="section surface-blue" aria-labelledby="reviews">
  <SectionHead id="reviews" label={r.label} heading={r.heading} />
  <ul class="gutter mt-14 md:mt-20 md:grid md:grid-cols-3 md:gap-x-12" role="list">
    {r.items.map((it, i) => (
      <li class="hairline py-8 md:py-0 md:border-0" data-reveal data-reveal-delay={String(i)}>
        <p class="text-gold tracking-[0.2em]" aria-label={`${it.rating} out of 5 stars`}>{'★'.repeat(it.rating)}</p>
        <blockquote class="display-wide mt-4 text-[1.375rem] leading-[1.3] text-paper md:text-2xl">
          <p>“{it.text}”</p>
        </blockquote>
        <p class="mt-5 text-sm text-muted">
          <span class="font-semibold text-paper/90">{it.author}</span>{it.badge && <span> · {it.badge}</span>}
        </p>
      </li>
    ))}
  </ul>
  <p class="gutter mt-10 md:mt-16" data-reveal>
    <a href={client.rating.url} rel="noopener" target="_blank" class="btn btn-ghost w-full md:w-auto">{r.linkText}</a>
  </p>
</section>
