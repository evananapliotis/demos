---
import { site } from '@/lib/client';
import Section from './Section.astro';
import Stars from './Stars.astro';
import GoogleG from './GoogleG.astro';
import Icons from './Icons.astro';
interface Props { number: string }
const { number } = Astro.props;
const hasReviews = site.reviews.length > 0;
---
{
  hasReviews ? (
    <Section id="reviews" number={number} eyebrow="Reviews" title="Don't take <em class='italic text-brass font-normal'>our</em> word for it.">
      <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16">
        <div class="md:sticky md:top-24 md:self-start">
          <p class="font-display text-[6rem] leading-none text-bone md:text-[8rem]">{site.google.rating.toFixed(1)}</p>
          <Stars rating={site.google.rating} class="mt-2 text-brass" size={22} />
          <p class="mt-3 flex items-center gap-2 text-bone-2"><GoogleG size={18} /> from {site.google.reviewCount} Google reviews</p>
          <a href={site.google.listingUrl} target="_blank" rel="noopener" class="btn btn-ghost mt-6">Read them all on Google <Icons name="arrow" size={16} /></a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2" role="list">
          {site.reviews.map((r) => (
            <li class="flex flex-col rounded-sm border border-line bg-ink-2 p-6">
              <Stars rating={r.rating} class="text-brass" size={14} />
              <blockquote class="mt-4 flex-1 text-[1.05rem] leading-relaxed text-bone"><p>“{r.text}”</p></blockquote>
              <footer class="mt-5 flex items-center justify-between gap-3 text-sm text-bone-2">
                <cite class="not-italic font-semibold text-bone">{r.author}</cite>
                <span class="inline-flex items-center gap-1.5"><GoogleG size={14} /> Google{r.date ? ` · ${r.date}` : ''}</span>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </Section>
  ) : (
    <section id="reviews" class="scroll-mt-16 border-y border-line bg-ink-2 grain px-5 py-20 sm:px-8 md:py-28 lg:px-12" aria-labelledby="reviews-title">
      <div class="mx-auto max-w-6xl" data-reveal>
        <p class="eyebrow flex items-center gap-3"><span class="tracking-[0.06em] text-bone-2">{number}</span> Rated on Google</p>
        <div class="mt-8 grid items-end gap-8 md:grid-cols-[auto_1fr] md:gap-14">
          <div class="flex items-end gap-5">
            <p class="font-display text-[8rem] leading-[0.78] text-bone md:text-[13rem]">{site.google.rating.toFixed(1)}</p>
            <div class="pb-1">
              <Stars rating={site.google.rating} class="text-brass" size={24} />
              <p class="mt-2 text-sm text-bone-2">out of 5</p>
            </div>
          </div>
          <div class="md:pb-3">
            <h2 id="reviews-title" class="font-display text-[clamp(2rem,7vw,3.75rem)] leading-[1] text-bone">
              {site.google.reviewCount} reviews.<br /><em class="font-normal italic text-brass">Read them yourself.</em>
            </h2>
            <a href={site.google.listingUrl} target="_blank" rel="noopener" class="btn btn-brass mt-7">
              <GoogleG size={18} /> Open the Google listing <Icons name="arrow" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
