---
import { Image } from 'astro:assets';
import { client, photo } from '../lib/client';
import SectionHead from './SectionHead.astro';
const g = client.gallery;
---
<section class="section" aria-labelledby="gallery">
  <SectionHead id="gallery" label={g.label} heading={g.heading} />
  <div class="mt-14 grid grid-cols-2 gap-2 md:mt-20 md:gap-3">
    {g.photos.map((p) => {
      const wide = p.span === 2;
      return (
        <figure class:list={['photo-hover relative', wide && 'col-span-2']} data-reveal>
          <Image
            src={photo(p.src)} alt={p.alt}
            widths={[400, 800, 1200, 1600]} sizes={wide ? '100vw' : '(min-width: 48rem) 50vw, 50vw'}
            format="webp" quality={78} loading="lazy" decoding="async"
            class:list={['w-full object-cover', wide ? 'aspect-[4/3] md:aspect-[21/9]' : 'aspect-[3/4] md:aspect-[4/5]']}
            style={`${p.aspect ? `aspect-ratio:${p.aspect};` : ''}object-position:${p.position ?? '50% 50%'}`}
          />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-[linear-gradient(to_top,rgb(10_10_11/0.72),transparent)]" aria-hidden="true"></div>
          {p.caption && <figcaption class="label absolute bottom-4 left-4 text-paper/90 md:bottom-5 md:left-5">{p.caption}</figcaption>}
        </figure>
      );
    })}
  </div>
</section>
