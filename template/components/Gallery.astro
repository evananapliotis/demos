---
import { Image } from 'astro:assets';
import { client, photo } from '../lib/client';
import SectionHead from './SectionHead.astro';
const g = client.gallery;
---
<section class="section" aria-labelledby="gallery">
  <SectionHead id="gallery" label={g.label} heading={g.heading} />
  <div class="mt-14 grid gap-3 md:mt-20 md:grid-cols-2">
    {g.photos.map((p, i) => (
      <figure class:list={['relative photo-hover', i === g.photos.length - 1 && g.photos.length % 2 === 1 && 'md:col-span-2']} data-reveal>
        <Image
          src={photo(p.src)} alt={p.alt}
          widths={[480, 800, 1200, 1600]} sizes="(min-width: 48rem) 50vw, 100vw"
          format="webp" quality={78} loading="lazy" decoding="async"
          class:list={['w-full object-cover', i === g.photos.length - 1 && g.photos.length % 2 === 1 && 'md:aspect-[16/7]']}
          style={`aspect-ratio:${p.aspect ?? '4 / 5'};object-position:${p.position ?? '50% 50%'}`}
        />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-32 bg-[linear-gradient(to_top,rgb(10_10_11/0.7),transparent)] md:block" aria-hidden="true"></div>
        {p.caption && <figcaption class="label mt-3 px-6 text-paper/60 md:absolute md:bottom-5 md:left-5 md:mt-0 md:px-0 md:text-paper/90">{p.caption}</figcaption>}
      </figure>
    ))}
  </div>
</section>
