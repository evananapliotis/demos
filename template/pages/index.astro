---
import { getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { site, heroImage, galleryImages } from '@/lib/client';
import Hero from '@/components/Hero.astro';
import Services from '@/components/Services.astro';
import Gallery from '@/components/Gallery.astro';
import Reviews from '@/components/Reviews.astro';
import About from '@/components/About.astro';
import Hours from '@/components/Hours.astro';
import Footer from '@/components/Footer.astro';
import StickyBar from '@/components/StickyBar.astro';
import Marquee from '@/components/Marquee.astro';

const title = `${site.name} | Barbers in ${site.address.locality}`;
// Same transform as the <Image> in Hero so the preload hits the same URLs.
const hero = heroImage
  ? await getImage({
      src: heroImage,
      widths: [480, 768, 1080, 1440, 1920],
      sizes: '100vw',
      layout: 'full-width',
      format: 'webp',
      quality: 72,
    })
  : null;
// Section numbers skip the gallery when there are no photos.
const hasGallery = galleryImages.length > 0;
const n = ['01', hasGallery ? '02' : '', hasGallery ? '03' : '02', hasGallery ? '04' : '03', hasGallery ? '05' : '04'];
---
<Base title={title} description={site.description} hero={hero}>
  <Hero hero={hero} />
  <Marquee />
  <main id="main">
    <Services number={n[0]} />
    <Gallery number={n[1]} />
    <Reviews number={n[2]} />
    <About number={n[3]} />
    <Hours number={n[4]} />
  </main>
  <Footer />
  <StickyBar />
</Base>
