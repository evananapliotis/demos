---
import { client, telHref, waHref, fmtHours } from '../lib/client';
const a = client.address;
const year = new Date().getFullYear();
---
<footer class="bg-ink-2 pb-32 pt-16 md:pb-16" aria-label="Footer">
  <div class="gutter grid gap-12 md:grid-cols-3">
    <div>
      <p class="display text-[2rem] leading-none text-paper">{client.name}</p>
      <p class="mt-3 text-sm text-muted">Barbers · {a.street}, {client.area}</p>
    </div>
    <div class="text-[0.9375rem] leading-relaxed">
      <p class="label mb-4">Get in touch</p>
      <a href={telHref} class="link text-paper/85 hover:text-paper">Call {client.phone.display}</a><br />
      <a href={waHref} rel="noopener" target="_blank" class="link text-paper/85 hover:text-paper">WhatsApp {client.phone.display}</a><br />
      <a href={client.rating.url} rel="noopener" target="_blank" class="link text-paper/85 hover:text-paper">Find us on Google</a>
    </div>
    <div class="text-[0.9375rem] leading-relaxed text-paper/85">
      <p class="label mb-4">Hours</p>
      {client.hours.map((h) => <p>{h.days} {fmtHours(h)}</p>)}
      <p class="mt-3 text-muted">{a.street}, {a.locality}, {a.town} {a.postcode}</p>
    </div>
  </div>
  <p class="gutter mt-14 text-xs text-muted">© {year} {client.name}</p>
</footer>
