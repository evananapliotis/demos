---
import { client, fmtHours, mapsEmbedUrl, mapsDirectionsUrl } from '../lib/client';
import SectionHead from './SectionHead.astro';
import Cta from './Cta.astro';
const f = client.find;
const a = client.address;
---
<section id="find" class="section hairline pb-0!" aria-labelledby="find-title">
  <div class="gutter md:grid md:grid-cols-12 md:gap-x-12">
    <div class="md:col-span-5">
      <SectionHead id="find-title" label={f.label} heading={f.heading} accent={f.accent} />
      <p class="measure mt-10 text-paper/80" data-reveal data-reveal-delay="1">{client.hoursNote}</p>
      <div class="mt-10 flex flex-col gap-3 md:flex-row md:items-center" data-reveal data-reveal-delay="2">
        <Cta kind="call" class="w-full md:w-auto md:min-w-[16rem]" />
        <a href={mapsDirectionsUrl} rel="noopener" target="_blank" class="btn btn-ghost w-full md:w-auto">{f.directions}</a>
      </div>
    </div>

    <div class="mt-20 md:col-span-5 md:col-start-8 md:mt-2">
      <div data-reveal data-reveal-delay="1">
        <h3 class="label">Hours</h3>
        <dl class="mt-5">
          {client.hours.map((h) => (
            <div class="hairline flex items-baseline justify-between py-4 first:border-t-0 first:pt-0">
              <dt class="display-mid text-[1.375rem] text-paper">{h.days}</dt>
              <dd class="display-mid text-[1.375rem] tabular-nums text-paper/85">{fmtHours(h)}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="mt-14" data-reveal data-reveal-delay="2">
        <h3 class="label">Where</h3>
        <address class="display-mid mt-5 text-[1.375rem] not-italic leading-[1.25] text-paper">{a.street},<br />{a.locality}, {a.town} {a.postcode}</address>
        <p class="mt-6"><a href={client.rating.url} rel="noopener" target="_blank" class="link text-[0.9375rem] text-paper/80 hover:text-paper">See the listing on Google</a></p>
      </div>
    </div>
  </div>

  <div class="mt-20 md:mt-28" data-reveal>
    <iframe
      title={`Map showing ${client.name} at ${a.street}, ${a.locality}`}
      src={mapsEmbedUrl}
      width="100%" height="380" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen class="block h-[380px] w-full border-0 bg-ink-2 md:h-[520px]"
      style="filter: grayscale(1) contrast(1.05) brightness(0.9)"
    ></iframe>
  </div>
</section>
