---
import { client } from '../lib/client';
import SectionHead from './SectionHead.astro';
import Stars from './Stars.astro';
import Cta from './Cta.astro';
const s = client.shave;
---
<section id="shave" class="section bg-paper text-ink" aria-labelledby="shave-title">
  <div class="gutter md:grid md:grid-cols-12 md:gap-x-12">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-28">
        <SectionHead id="shave-title" label={s.label} heading={s.heading} accent={s.accent} tone="light" />
        <div class="mt-10">
          {s.paragraphs.map((p, i) => (
            <p class:list={['measure text-ink/75', i > 0 && 'mt-5']} data-reveal data-reveal-delay={String(i + 1)}>{p}</p>
          ))}
        </div>
        <figure class="mt-12 border-l border-accent-deep pl-5" data-reveal data-reveal-delay="3">
          <Stars class="text-accent-deep" size={11} />
          <blockquote class="mt-3">
            <p class="display-mid text-[1.5rem] leading-[1.15] text-ink md:text-[1.75rem]">“{s.quote.text}”</p>
          </blockquote>
          <figcaption class="mt-4 text-sm text-muted-ink">{s.quote.author}, on Google</figcaption>
        </figure>
        <div class="mt-10 hidden md:block" data-reveal data-reveal-delay="3">
          <Cta kind="call" variant="ink" label={s.cta} />
        </div>
      </div>
    </div>
    <ol class="mt-16 md:col-span-7 md:mt-0" role="list">
      {s.steps.map((st, i) => (
        <li class="row hairline-ink grid grid-cols-[3.5rem_1fr] items-start gap-x-4 py-9 first:border-t-0 first:pt-0 md:grid-cols-[5rem_1fr] md:py-11" data-reveal data-reveal-delay={String(i % 3)}>
          <span class="idx display-mid pt-1 text-[2rem] leading-none text-accent-deep md:text-[2.5rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="display h3-size text-ink">{st.title}</h3>
            <p class="mt-3 max-w-[34ch] text-ink/72">{st.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-12 md:hidden" data-reveal>
      <Cta kind="call" variant="ink" class="w-full" label={s.cta} />
    </div>
  </div>
</section>
