---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Van from '../components/Van.astro';
import How from '../components/How.astro';
import Families from '../components/Families.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Reviews from '../components/Reviews.astro';
import Book from '../components/Book.astro';
import Footer from '../components/Footer.astro';
import Sticky from '../components/Sticky.astro';
import { client, photo } from '../lib/client';

const heroSrc = photo(client.hero.src);
const hero = await getImage({ src: heroSrc, widths: [480, 800, 1200, 1600], sizes: '100vw', format: 'webp', quality: 72 });
const og = await getImage({ src: heroSrc, width: 1200, height: 630, format: 'jpg', quality: 82, fit: 'cover', position: 'attention' });
const ogImage = new URL(og.src, Astro.site).href;
const heroImg = {
  src: hero.src,
  srcSet: hero.srcSet.attribute,
  sizes: '100vw',
  width: hero.attributes.width as number,
  height: hero.attributes.height as number,
};
---
<Base hero={heroImg} ogImage={ogImage}>
  <main id="main">
    <Hero img={heroImg} />
    <Van />
    <How />
    <Families />
    <Services />
    <Work />
    <Reviews />
    <Book />
  </main>
  <Footer />
  <Sticky />
</Base>
