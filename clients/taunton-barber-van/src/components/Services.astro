---
import { client } from '../lib/client';
import SectionHead from './SectionHead.astro';
const s = client.services;
---
<section id="services" class="section hairline" aria-labelledby="services-title">
  <div class="gutter md:grid md:grid-cols-12 md:gap-x-12">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-28">
        <SectionHead id="services-title" label={s.label} heading={s.heading} accent={s.accent} />
        <div class="mt-10 border-l border-brass pl-5" data-reveal data-reveal-delay="2">
          <p class="label text-brass">{s.pricingLabel}</p>
          <p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-relaxed text-paper/72">{s.pricingNote}</p>
        </div>
      </div>
    </div>
    <ol class="mt-14 md:col-span-7 md:mt-0" role="list">
      {s.items.map((it, i) => (
        <li class="row hairline flex items-baseline gap-x-5 py-7 first:border-t-0 first:pt-0 md:py-8" data-reveal data-reveal-delay={String(i % 3)}>
          <span class="idx label w-8 shrink-0 text-brass/80" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="display h3-size text-paper">{it.name}</h3>
            {it.note && <p class="mt-2.5 max-w-[34ch] text-[0.9375rem] leading-relaxed text-muted">{it.note}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
