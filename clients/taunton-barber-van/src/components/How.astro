---
import { client } from '../lib/client';
import SectionHead from './SectionHead.astro';
import Cta from './Cta.astro';
const h = client.how;
---
<section id="how" class="section bg-paper text-ink" aria-labelledby="how-title">
  <div class="gutter md:grid md:grid-cols-12 md:gap-x-12">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-28">
        <SectionHead id="how-title" label={h.label} heading={h.heading} accent={h.accent} tone="light" />
        <div class="mt-10 hidden md:block" data-reveal data-reveal-delay="2">
          <Cta kind="whatsapp" variant="ink" />
        </div>
      </div>
    </div>
    <ol class="mt-14 md:col-span-7 md:mt-0" role="list">
      {h.steps.map((s, i) => (
        <li class="row hairline-ink grid grid-cols-[3.5rem_1fr] items-start gap-x-4 py-9 first:border-t-0 first:pt-0 md:grid-cols-[5rem_1fr] md:py-11" data-reveal data-reveal-delay={String(i)}>
          <span class="display-mid pt-1 text-[2rem] leading-none text-brass-deep md:text-[2.5rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="display h3-size text-ink">{s.title}</h3>
            <p class="mt-3 max-w-[34ch] text-ink/72">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-12 md:hidden" data-reveal>
      <Cta kind="whatsapp" variant="ink" class="w-full" />
    </div>
  </div>
</section>
