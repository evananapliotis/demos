---
import { client, fmtHours } from '../lib/client';
import SectionHead from './SectionHead.astro';
import Cta from './Cta.astro';
const b = client.book;
---
<section id="book" class="section" aria-labelledby="book-title">
  <div class="gutter md:grid md:grid-cols-12 md:gap-x-12">
    <div class="md:col-span-6">
      <SectionHead id="book-title" label={b.label} heading={b.heading} accent={b.accent} />
      <p class="measure mt-10 text-paper/80" data-reveal data-reveal-delay="1">{b.body}</p>
      <div class="mt-10 flex flex-col gap-3 md:flex-row md:items-center" data-reveal data-reveal-delay="2">
        <Cta kind="whatsapp" label={b.whatsapp} class="w-full md:w-auto md:min-w-[16rem]" />
        <Cta kind="call" label={b.call} variant="ghost" class="w-full md:w-auto" />
      </div>
    </div>

    <div class="mt-20 md:col-span-5 md:col-start-8 md:mt-2">
      <div data-reveal data-reveal-delay="1">
        <h3 class="label">Hours</h3>
        <dl class="mt-5">
          {client.hours.map((h) => (
            <div class="hairline flex items-baseline justify-between py-4 first:border-t-0 first:pt-0">
              <dt class="display-mid text-[1.375rem] text-paper">{h.days}</dt>
              <dd class="display-mid text-[1.375rem] tabular-nums text-paper/85">{fmtHours(h)}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="mt-14" data-reveal data-reveal-delay="2">
        <h3 class="label">Where</h3>
        <p class="display-mid mt-5 text-[1.375rem] leading-[1.25] text-paper">{client.base.street}, {client.base.locality} {client.base.postcode}</p>
        <p class="mt-4 max-w-[34ch] text-[0.9375rem] leading-relaxed text-muted">{b.baseNote}</p>
        <p class="mt-6"><a href={client.rating.url} rel="noopener" target="_blank" class="link text-[0.9375rem] text-paper/80 hover:text-paper">See the listing on Google</a></p>
      </div>
    </div>
  </div>
</section>
