---
import { Image } from 'astro:assets';
import { client, photo } from '../lib/client';
import SectionHead from './SectionHead.astro';
import Stars from './Stars.astro';
const f = client.families;
---
<section id="families" class="section" aria-labelledby="families-title">
  <div class="gutter md:grid md:grid-cols-12 md:gap-x-12">
    <div class="md:col-span-5 md:pr-6">
      <SectionHead id="families-title" label={f.label} heading={f.heading} accent={f.accent} />
      <div class="mt-10">
        {f.paragraphs.map((p, i) => (
          <p class:list={['measure text-paper/80', i > 0 && 'mt-6']} data-reveal data-reveal-delay={String(i + 1)}>{p}</p>
        ))}
      </div>
      <figure class="mt-12 border-l border-brass pl-5" data-reveal data-reveal-delay="3">
        <Stars class="text-brass" size={11} />
        <blockquote class="mt-3">
          <p class="display-mid text-[1.5rem] leading-[1.15] text-paper md:text-[1.75rem]">“{f.quote.text}”</p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-muted">{f.quote.author}, on Google</figcaption>
      </figure>
    </div>

    <div class="-mx-6 mt-16 grid grid-cols-2 gap-1.5 md:col-span-7 md:mx-0 md:mt-2 md:gap-4">
      {f.photos.map((p, i) => (
        <figure class:list={['photo-hover', i === 1 && 'mt-12 md:mt-24']} data-reveal data-reveal-delay={String(i)}>
          <Image
            src={photo(p.src)} alt={p.alt}
            widths={[320, 480, 720, 960]} sizes="(min-width: 48rem) 30vw, 50vw"
            format="webp" quality={76} loading="lazy" decoding="async"
            class="photo aspect-[3/4] w-full object-cover"
            style={`object-position:${p.position ?? '50% 50%'}`}
          />
          {p.caption && <figcaption class="label mt-3 px-4 text-paper/60 md:px-0">{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>
