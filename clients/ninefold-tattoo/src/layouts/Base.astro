---
import '../styles/global.css';
import { site, artists, mapsHref, openingHoursSpec } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: { src: string; alt: string };
  heroPreload?: { src: string; srcSet: string; sizes: string };
  noindex?: boolean;
}
const { title = site.seo.title, description = site.seo.description, ogImage, heroPreload, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '');
const home = Astro.site!.href.replace(/\/$/, '');
const a = site.address;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  '@id': `${home}/#studio`,
  name: site.name,
  description: site.seo.description,
  url: home,
  image: ogImage?.src,
  telephone: site.phone.tel,
  email: site.email,
  foundingDate: site.established,
  priceRange: '££',
  currenciesAccepted: 'GBP',
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.street,
    addressLocality: a.city,
    addressRegion: 'Greater Manchester',
    postalCode: a.postcode,
    addressCountry: a.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: mapsHref,
  areaServed: { '@type': 'City', name: site.city },
  openingHoursSpecification: openingHoursSpec(),
  employee: artists.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: `Tattoo artist, ${p.style.toLowerCase()}` })),
  makesOffer: artists.map((p) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: `${p.style} tattooing`, provider: { '@id': `${home}/#studio` } },
    priceCurrency: 'GBP',
  })),
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />
    <meta name="geo.region" content="GB-MAN" />
    <meta name="geo.placename" content={`${a.area}, ${a.city}`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />

    <meta property="og:type" content="business.business" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {ogImage && <meta property="og:image" content={ogImage.src} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImage.alt} />}
    <meta property="business:contact_data:street_address" content={a.street} />
    <meta property="business:contact_data:locality" content={a.city} />
    <meta property="business:contact_data:postal_code" content={a.postcode} />
    <meta property="business:contact_data:country_name" content="United Kingdom" />
    <meta property="business:contact_data:phone_number" content={site.phone.tel} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage.src} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImage.alt} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {heroPreload && <link rel="preload" as="image" href={heroPreload.src} imagesrcset={heroPreload.srcSet} imagesizes={heroPreload.sizes} fetchpriority="high" />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-ink text-bone">
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
