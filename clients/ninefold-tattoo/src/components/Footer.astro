---
import { site, footer, telHref, mailHref, mapsHref, fmtTime } from '../data/site';
import { markSvg } from '../lib/favicon';
---
<footer class="border-t border-hairline pb-20 md:pb-0">
  <div class="border-b border-hairline">
    <p class="wrap gutter label py-4 text-bone!">{site.disclaimer}</p>
  </div>
  <div class="wrap gutter grid gap-12 py-16 md:grid-cols-12 md:py-24">
    <div class="md:col-span-5">
      <a href="#top" class="flex items-center gap-3" aria-label={`${site.name}, top of page`}>
        <span class="block h-5 w-5 [&>svg]:h-full [&>svg]:w-full" set:html={markSvg(64, true)} />
        <span class="font-serif text-3xl leading-none tracking-tight">{site.name}</span>
      </a>
      <p class="muted mt-6 max-w-[36ch]">{footer.blurb}</p>
    </div>
    <dl class="grid gap-10 sm:grid-cols-3 md:col-span-7">
      <div>
        <dt class="label">Find us</dt>
        <dd class="mt-3 leading-relaxed">
          <a class="link" href={mapsHref} rel="noopener" target="_blank">{site.address.street}<br />{site.address.area}<br />{site.address.city} {site.address.postcode}</a>
        </dd>
      </div>
      <div>
        <dt class="label">Hours</dt>
        <dd class="mt-3 leading-relaxed">
          {site.hours.map((h) => (
            <span class="flex justify-between gap-4 sm:block">
              <span>{h.days}</span>
              <span class="muted">{h.closed || !h.open || !h.close ? 'Closed' : `${fmtTime(h.open)} – ${fmtTime(h.close)}`}</span>
            </span>
          ))}
          <span class="mt-3 block text-sm text-bone-55">{site.hoursNote}</span>
        </dd>
      </div>
      <div>
        <dt class="label">Talk to us</dt>
        <dd class="mt-3 flex flex-col items-start gap-2 leading-relaxed">
          <a class="link" href={telHref}>{site.phone.display}</a>
          <a class="link" href={mailHref}>{site.email}</a>
          {site.socials.map((s) => (
            <a class="link" href={s.href} rel="noopener" target="_blank">{s.label} <span class="muted">{s.handle}</span></a>
          ))}
        </dd>
      </div>
    </dl>
  </div>
  <div class="border-t border-hairline">
    <div class="wrap gutter flex flex-col gap-3 py-6 text-[0.8125rem] leading-relaxed text-bone-55 md:flex-row md:items-start md:justify-between md:gap-12">
      <p class="max-w-[70ch]">{site.disclaimerLong}</p>
      <p class="shrink-0">Est. {site.established} · {site.area}, {site.city}</p>
    </div>
  </div>
</footer>
