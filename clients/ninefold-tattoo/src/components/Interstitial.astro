---
import { Image } from 'astro:assets';
import { interstitial as it } from '../data/site';
import { photo } from '../lib/images';
---
<section class="grain relative aspect-[4/5] overflow-hidden md:aspect-[21/9]" aria-label={it.line}>
  <Image
    src={photo(it.slot)}
    alt={it.alt}
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    quality={74}
    loading="lazy"
    decoding="async"
    class="photo absolute inset-0 h-full w-full object-cover"
    style={`object-position:${it.position}`}
  />
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(5_5_5/0.05)_0%,rgb(5_5_5/0.15)_45%,rgb(5_5_5/0.82)_100%)]" aria-hidden="true"></div>
  <div class="wrap gutter absolute inset-x-0 bottom-0 z-10 pb-12 md:pb-16" data-reveal>
    <p class="display max-w-[18ch] text-[2.25rem] md:text-[2.75rem] lg:text-[3.5rem]">{it.line}</p>
  </div>
</section>
