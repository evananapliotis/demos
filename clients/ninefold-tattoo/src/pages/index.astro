---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Work from '../components/Work.astro';
import FreshHealed from '../components/FreshHealed.astro';
import Artists from '../components/Artists.astro';
import Process from '../components/Process.astro';
import Interstitial from '../components/Interstitial.astro';
import Aftercare from '../components/Aftercare.astro';
import KindWords from '../components/KindWords.astro';
import Consult from '../components/Consult.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { hero, work } from '../data/site';
import { photo } from '../lib/images';

const heroImg = await getImage({ src: photo(hero.slot), widths: [640, 960, 1440, 1920], sizes: '100vw', format: 'webp', quality: 72 });

// The strongest piece leads the gallery and is the link preview.
const lead = work.pieces.find((p) => p.lead) ?? work.pieces[0];
const og = await getImage({ src: photo(lead.slot), width: 1200, height: 630, fit: 'cover', position: 'attention', format: 'jpeg', quality: 82 });
const ogImage = { src: new URL(og.src, Astro.site).href, alt: lead.alt };
---
<Base ogImage={ogImage} heroPreload={{ src: heroImg.src, srcSet: heroImg.srcSet.attribute, sizes: '100vw' }}>
  <Hero img={heroImg} />
  <main id="main">
    <Intro />
    <Work />
    <FreshHealed />
    <Artists />
    <Process />
    <Interstitial />
    <Aftercare />
    <KindWords />
    <Consult />
  </main>
  <Footer />
  <StickyBar />
</Base>
